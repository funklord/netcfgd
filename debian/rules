#!/usr/bin/make -f
#
# The version comes from the VERSION file at the root; `make version-check`
# gates debian/changelog and Cargo.toml against it.
#
# Only the systemd glue is packaged here. install-openrc and install-procd
# exist for Alpine and OpenWrt, which have their own packaging under
# packaging/ and must not be dragged into the deb.

# The GUI is behind a build profile rather than in a source package of its
# own, and the reason is `client/`. That directory is the shared C frontend
# layer: the GUI links it, and so does the daemon's own `make conformance`
# gate and `make cross`. A separate source package rooted at gui/ could not
# see it, so it would have to carry a copy -- and two copies of one thing is
# the drift this tree keeps finding. One source package, one version, one
# client. See 0126.
#
# A plain build produces the daemon and the shim and needs no Qt.
GUI_PROFILE := $(filter pkg.netcfgd.gui,$(DEB_BUILD_PROFILES))

%:
	dh $@

override_dh_auto_build:
	$(MAKE) build
	$(MAKE) nm
ifneq (,$(GUI_PROFILE))
	@# -C gui rather than the root `gui` target, which also runs the GUI test
	@# suite. dh_auto_test is a no-op here for the same reason: `make check`
	@# is the gate, and a package build is not the place to discover it.
	$(MAKE) -C gui
endif

override_dh_auto_install:
	$(MAKE) install DESTDIR=$(CURDIR)/debian/netcfgd PREFIX=/usr
	$(MAKE) install-systemd DESTDIR=$(CURDIR)/debian/netcfgd
	$(MAKE) install-sysvinit DESTDIR=$(CURDIR)/debian/netcfgd
	# Link-detection scripts. Executable, because netcfgd runs them, and
	# under /usr/share rather than /etc: these are examples the package owns
	# and replaces on upgrade. An operator's own go in /etc/netcfgd/probe,
	# which the package does not write.
	install -Dm755 packaging/probe/default \
		$(CURDIR)/debian/netcfgd/usr/share/netcfgd/probe/default
	install -Dm644 packaging/systemd/netcfgd-exclusive.conf \
		$(CURDIR)/debian/netcfgd/usr/share/doc/netcfgd/netcfgd-exclusive.conf
	@# The exclusive drop-in ships as documentation and is NOT installed into
	@# /etc/systemd/system/netcfgd.service.d. Copying it into place is the
	@# operator's act, by explicit instruction: installing a package must not
	@# decide that this machine's other network daemons stop.
	$(MAKE) install-nm DESTDIR=$(CURDIR)/debian/netcfgd-nm PREFIX=/usr
	$(MAKE) install-sysvinit-nm DESTDIR=$(CURDIR)/debian/netcfgd-nm
ifneq (,$(GUI_PROFILE))
	$(MAKE) install-gui DESTDIR=$(CURDIR)/debian/netcfgd-gui PREFIX=/usr
endif

# dh_installsystemd enables the unit and starts it, on first install, unless
# told otherwise -- and that is precisely what this package must not do.
#
# It was doing it. `debian/postinst`'s own header says "The unit is installed
# and deliberately not enabled, and nothing is started", and the generated
# snippets appended to that same script by debhelper ran `deb-systemd-helper
# enable` and `deb-systemd-invoke start`. The claim was in the half a person
# writes and the behaviour in the half a tool appends, so reading the file
# top to bottom showed both and agreed with neither.
#
# It matters twice over now that netcfgd-nm exists. netcfgd itself with an
# empty /etc/netcfgd compiles to an empty document and manages nothing, so
# starting it was harmless in effect if not in intent. Starting the shim is
# not: it takes org.freedesktop.NetworkManager, which stops NetworkManager --
# on `apt install`, on a machine whose operator has not asked for anything
# yet, and possibly over the network being reconfigured.
override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start

# The init scripts go in through `make install-sysvinit`, beside the unit and
# for the same reason: `dh_installinit` wants them at debian/<package>.init and
# would install, enable and start them on its own terms, where this tree keeps
# every init's glue under packaging/ and installs it deliberately.
#
# Disabled outright rather than configured, so it cannot start or enable
# anything it did not install. What an upgrade needs -- restarting a daemon
# that is already running -- the postinst does itself, with `invoke-rc.d
# try-restart`, which honours policy-rc.d the same way.
override_dh_installinit:
	@echo "override_dh_installinit: init scripts come from make install-sysvinit"

override_dh_auto_test:
	# `make check` is the gate; it wants a build tree the packaging keeps no
	# part of.

override_dh_auto_clean:
	$(MAKE) clean
