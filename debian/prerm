#!/bin/sh
# Stop the daemon if this machine is running it. Whatever netcfgd configured
# stays configured -- an interface does not go down because the thing that
# brought it up was removed, and pulling a package is not an instruction to
# take the network away.
set -e

case "$1" in
remove | deconfigure)
	# **Give the machine its network daemons back, before the files go.**
	# `postinst` masked them, and a mask outlives the package that applied
	# it -- so without this, removing netcfgd leaves a host on which
	# NetworkManager, networkd, connman, iwd, wpa_supplicant and the rest all
	# refuse to start, and no way online to find out why. 0145 records what
	# *one* daemon declining an interface cost; this would be all of them.
	#
	# It has to be here rather than in `postrm`, because for `remove` dpkg
	# deletes the package's files first and runs `postrm` after -- the
	# switcher would already be gone.
	#
	# `none` rather than naming one: unmask everything and start nothing.
	# Which daemon runs next is the operator's choice, and a package being
	# removed is the worst moment to make it for them.
	if [ -x /usr/sbin/netcfgd_select.sh ]; then
		/usr/sbin/netcfgd_select.sh none || true
	fi
	if [ -d /run/systemd/system ]; then
		# `deb-systemd-invoke` rather than `systemctl`, because it honours
		# policy-rc.d and systemctl does not. Without it, removing this package
		# inside a chroot or an image build reaches out and stops the service
		# on whatever is really running there. That is the whole reason the
		# policy layer exists, and it matters more here than for most packages,
		# because netcfgd is built into images on purpose.
		#
		# Not a dependency, and not guarded either: init-system-helpers is
		# Essential and Priority: required, so `deb-systemd-invoke` is on every
		# Debian system by definition. A `command -v` fallback to systemctl was
		# written first and removed -- it covered a machine that cannot exist,
		# and the branch it added was the one lintian objects to.
		deb-systemd-invoke stop netcfgd.service >/dev/null 2>&1 || true
	fi
	;;
esac

# debhelper's own snippets belong here, and had nowhere to go.
#
# Without this token dpkg-buildpackage generates them and drops them: they were
# written to debian/.debhelper/generated/netcfgd/ on every build and never
# reached the packaged script, which is why all three maintainer scripts ship
# byte-identical to their source. debhelper says nothing about it.
#
# It was harmless and was not safe. What the systemd snippet does by default is
# `deb-systemd-helper enable` and `deb-systemd-invoke start`, so anybody adding
# this token -- which is ordinary, and what Debian policy expects -- would have
# made `apt install netcfgd` enable and start the daemon, contradicting the
# header above with no diff to the header. debian/rules passes
# `--no-enable --no-start` so that the token is now safe to have, which is the
# order those two changes have to happen in.
#DEBHELPER#
