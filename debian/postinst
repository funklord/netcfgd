#!/bin/sh
# Installing netcfgd makes netcfgd this machine's network daemon.
#
# **This reverses what this file used to say**, on the copyright holder's
# instruction (0168). It read "installing netcfgd must not change how this
# machine's network works", shipped the unit disabled, and shipped the
# exclusive drop-in as documentation -- so a machine that installed netcfgd
# got a program that did nothing until three further commands were run, and
# one that lost every argument with whatever was already holding the
# interfaces.
#
# The work is `netcfgd_select.sh`, not a block of systemctl calls here. It is
# one tool that goes both ways: `postrm` calls it with `none` on the way out,
# and an operator who wants NetworkManager back for an afternoon runs
# `netcfgd_select.sh networkmanager` rather than reconstructing a dozen
# invocations from memory. A takeover with no way back is the thing that
# leaves a machine unusable, and 0145 already records what "no daemon on this
# machine at all" costs.
#
# What it stands down are *services*. No package is removed and no binary
# renamed: netcfgd runs wpa_supplicant, dhcpcd, hostapd, pppd, openvpn,
# udhcpc, odhcp6c and resolvconf itself, and the NetworkManager package stays
# because desktop wireless applets depend on it -- they work against netcfgd
# through `netcfgd-nm`, which serves NM's own bus name. What cannot run is
# the NM *daemon*: two processes cannot own one bus name.
set -e

case "$1" in
configure)
	# Reserved, and empty. 0118: a client run by a desktop user cannot reach a
	# root-only socket, and the two ways out are joining a group or the
	# client's own administrator mode -- this is the group.
	#
	# Its own group rather than `netdev`, which every desktop already has and
	# NetworkManager already uses: pointing the policy there would mean
	# installing netcfgd silently grants network configuration to everybody
	# who joined that group years ago for an unrelated reason. Empty, so
	# joining it is a thing somebody did.
	#
	# The group is created and *no policy is written*. Installing netcfgd must
	# not change how this machine's network works, and a policy widens who may
	# configure it -- so that stays one command the operator runs.
	if ! getent group netcfgd >/dev/null 2>&1; then
		addgroup --system netcfgd >/dev/null 2>&1 || true
	fi

	# **Only on a first install.** `$2` is the version being upgraded from,
	# so this is empty exactly once. An upgrade must not re-take a machine
	# whose operator has since chosen NetworkManager: they ran
	# `netcfgd_select.sh networkmanager` and meant it, and an upgrade that
	# silently undid that would make the switcher a lie.
	# **The unit systemd is RUNNING, not the one on disk.**
	#
	# `debian/rules` passes `dh_installsystemd --no-enable --no-start`, and
	# debhelper reads `--no-start` as "emit no postinst systemd snippet at
	# all" -- `RESTART_AFTER_UPGRADE` defaults to true only when `--no-start`
	# is absent, so both branches that would have written one are skipped.
	# What those snippets carry, besides the start nobody wanted here, is
	# `systemctl --system daemon-reload`.
	#
	# So an upgrade wrote a new `netcfgd.service` and systemd went on running
	# the old one, and the `try-restart` below re-executed the daemon **under
	# the stale unit** -- new binary, previous sandbox. Reported from an
	# install as netcfgd refusing every write with "Read-only file system"
	# naming `/etc/netcfgd/conf.d`, on a machine whose installed unit had
	# named `/etc` in `ReadWritePaths=` since 2026-08-21.
	#
	# Unconditional, and before anything that starts or restarts: on a first
	# install it costs one reload of a unit systemd has not seen, and on an
	# upgrade it is the difference between the fix being installed and the fix
	# being in force.
	if [ -d /run/systemd/system ]; then
		systemctl --system daemon-reload >/dev/null 2>&1 || true
	fi

	# **Permissions, applied every time and not only on a first install.**
	#
	# dpkg sets modes for files the package ships; it knows nothing about the
	# ones netcfgd creates as it runs, and an older version's mistake outlives
	# the version that made it. The credential store is the one that matters:
	# `ncfg secret set` makes it 0700 today, and a machine that has been
	# through an earlier netcfgd may hold one that is not.
	#
	# `install -d` rather than `mkdir -p`: it sets the mode on a directory
	# that already exists as well as on one it creates, which is the whole
	# point of doing this on every configure.
	install -d -m 0755 -o root -g root /etc/netcfgd /etc/netcfgd/conf.d
	if [ -d /etc/netcfgd/secrets ]; then
		chown root:root /etc/netcfgd/secrets || true
		chmod 0700 /etc/netcfgd/secrets || true
		# The credentials themselves. 0600 is what writes them (0042), and a
		# file that is readable by anyone else is a private key somebody can
		# copy -- which no later tightening of the directory takes back.
		find /etc/netcfgd/secrets -mindepth 1 -maxdepth 1 -type f \
			-exec chown root:root {} + -exec chmod 0600 {} + || true
	fi

	if [ -z "$2" ] && [ -x /usr/sbin/netcfgd_select.sh ]; then
		/usr/sbin/netcfgd_select.sh netcfgd || true
	fi

	echo "netcfgd: installed, and it is now this machine's network daemon."
	echo "netcfgd:   the other network services are stopped, disabled and"
	echo "netcfgd:   masked -- the SERVICES only. No package was removed and"
	echo "netcfgd:   no binary renamed."
	echo "netcfgd:"
	echo "netcfgd:   to go back, or to choose something else:"
	echo "netcfgd:     netcfgd_select.sh networkmanager"
	echo "netcfgd:     netcfgd_select.sh --dry-run   # what it would do"
	echo "netcfgd:"
	echo "netcfgd:   write /etc/netcfgd/netcfgd.conf, then:"
	echo "netcfgd:     ncfg plan      # what it would do, and why"
	echo "netcfgd:     ncfg apply     # do it"
	echo "netcfgd:"
	echo "netcfgd:   every feature, with the syntax to use it, is in"
	echo "netcfgd:     /etc/netcfgd/netcfgd.conf.example"
	echo "netcfgd:   which netcfgd never reads. It is there for a machine with"
	echo "netcfgd:   no network to look anything up with."
	echo "netcfgd:"
	echo "netcfgd:   a client run by an ordinary user is refused until you say so:"
	echo "netcfgd:     ncfg control set --observe group:netcfgd --wifi group:netcfgd"
	echo "netcfgd:     usermod -aG netcfgd USER   # then log out and back in"
	echo "netcfgd:   that covers scanning, joining and adding a network. Changing"
	echo "netcfgd:   anything else stays root; ncfg control show prints the policy"

	# **An upgrade restarts a daemon that is already running, and only that.**
	# `$2` is the version being upgraded from, so it is empty on a first
	# install -- which is what keeps the header above true: installing netcfgd
	# still starts nothing.
	#
	# `try-restart` and not `restart`: it acts only on a unit that is already
	# active, so a machine that installed netcfgd and never enabled it is not
	# quietly given a running daemon by an upgrade.
	#
	# This is safe because of what the unit says, not because a restart is
	# inherently cheap. `KillMode=process` means stopping netcfgd leaves the
	# supplicant and the dhcp client running (0134, 0142), and
	# `RuntimeDirectoryPreserve=restart` keeps the record of what netcfgd owns
	# (0135). Before those two, this would have taken the network down on every
	# upgrade and then failed to recognise what was left.
	#
	# Without it the old binary kept running until somebody restarted it by
	# hand, which meant a security fix reached the disk and not the process.
	if [ -n "$2" ]; then
		if [ -d /run/systemd/system ]; then
			deb-systemd-invoke try-restart netcfgd.service >/dev/null 2>&1 || true
		elif command -v invoke-rc.d >/dev/null 2>&1; then
			invoke-rc.d netcfgd try-restart >/dev/null 2>&1 || true
		fi
	fi
	;;
abort-upgrade | abort-remove | abort-deconfigure) ;;
esac

# debhelper's own snippets belong here, and had nowhere to go.
#
# Without this token dpkg-buildpackage generates them and drops them: they were
# written to debian/.debhelper/generated/netcfgd/ on every build and never
# reached the packaged script, which is why all three maintainer scripts ship
# byte-identical to their source. debhelper says nothing about it.
#
# It was harmless and was not safe. What the systemd snippet does by default is
# `deb-systemd-helper enable` and `deb-systemd-invoke start`, so anybody adding
# this token -- which is ordinary, and what Debian policy expects -- would have
# made `apt install netcfgd` enable and start the daemon, contradicting the
# header above with no diff to the header. debian/rules passes
# `--no-enable --no-start` so that the token is now safe to have, which is the
# order those two changes have to happen in.
#DEBHELPER#
