#!/bin/sh
# Installing netcfgd must not change how this machine's network works.
#
# The unit is installed and deliberately not enabled, and nothing is started.
# A network daemon that took over on `apt install` could take the machine off
# the network before its operator had written a line of configuration -- and
# netcfgd's whole shape is that it says what it will do before it does it.
set -e

case "$1" in
configure)
	# Reserved, and empty. 0118: a client run by a desktop user cannot reach a
	# root-only socket, and the two ways out are joining a group or the
	# client's own administrator mode -- this is the group.
	#
	# Its own group rather than `netdev`, which every desktop already has and
	# NetworkManager already uses: pointing the policy there would mean
	# installing netcfgd silently grants network configuration to everybody
	# who joined that group years ago for an unrelated reason. Empty, so
	# joining it is a thing somebody did.
	#
	# The group is created and *no policy is written*. Installing netcfgd must
	# not change how this machine's network works, and a policy widens who may
	# configure it -- so that stays one command the operator runs.
	if ! getent group netcfgd >/dev/null 2>&1; then
		addgroup --system netcfgd >/dev/null 2>&1 || true
	fi

	echo "netcfgd: installed. Nothing is configured and nothing is running."
	echo "netcfgd:   write /etc/netcfgd/netcfgd.conf, then:"
	echo "netcfgd:     ncfg plan      # what it would do, and why"
	echo "netcfgd:     ncfg apply     # do it"
	echo "netcfgd:   to run it as a daemon: systemctl enable --now netcfgd"
	echo "netcfgd:"
	echo "netcfgd:   every feature, with the syntax to use it, is in"
	echo "netcfgd:     /etc/netcfgd/netcfgd.conf.example"
	echo "netcfgd:   which netcfgd never reads. It is there for a machine with"
	echo "netcfgd:   no network to look anything up with."
	echo "netcfgd:"
	echo "netcfgd:   a client run by an ordinary user is refused until you say so:"
	echo "netcfgd:     ncfg control set --observe group:netcfgd --wifi group:netcfgd"
	echo "netcfgd:     usermod -aG netcfgd USER   # then log out and back in"
	echo "netcfgd:   that covers scanning, joining and adding a network. Changing"
	echo "netcfgd:   anything else stays root; ncfg control show prints the policy"
	;;
abort-upgrade | abort-remove | abort-deconfigure) ;;
esac

# debhelper's own snippets belong here, and had nowhere to go.
#
# Without this token dpkg-buildpackage generates them and drops them: they were
# written to debian/.debhelper/generated/netcfgd/ on every build and never
# reached the packaged script, which is why all three maintainer scripts ship
# byte-identical to their source. debhelper says nothing about it.
#
# It was harmless and was not safe. What the systemd snippet does by default is
# `deb-systemd-helper enable` and `deb-systemd-invoke start`, so anybody adding
# this token -- which is ordinary, and what Debian policy expects -- would have
# made `apt install netcfgd` enable and start the daemon, contradicting the
# header above with no diff to the header. debian/rules passes
# `--no-enable --no-start` so that the token is now safe to have, which is the
# order those two changes have to happen in.
#DEBHELPER#
