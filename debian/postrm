#!/bin/sh
# On purge, take back only what this package created.
#
# /etc/netcfgd holds the operator's configuration and, under secrets/, key
# material that decision 0042 calls irrecoverable. The package ships no file
# in there, so dpkg removes none -- and this does not either. The directory
# goes only if it is empty.
set -e

# **The unmasking is in `prerm`, not here, and that is an ordering fact
# rather than a preference.** For `remove`, dpkg deletes the package's files
# and *then* runs `postrm` -- so /usr/sbin/netcfgd_select.sh is already gone
# by the time this script could call it, the `-x` guard would skip silently,
# and the machine would keep every network daemon masked with nothing left
# able to unmask them. Written here once because the first draft of this
# change put it in this file and it would have failed exactly that way.

case "$1" in
purge)
	if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
		systemctl daemon-reload >/dev/null 2>&1 || true
	fi
	rmdir --ignore-fail-on-non-empty /etc/netcfgd 2>/dev/null || true
	;;
esac

# debhelper's own snippets belong here, and had nowhere to go.
#
# Without this token dpkg-buildpackage generates them and drops them: they were
# written to debian/.debhelper/generated/netcfgd/ on every build and never
# reached the packaged script, which is why all three maintainer scripts ship
# byte-identical to their source. debhelper says nothing about it.
#
# It was harmless and was not safe. What the systemd snippet does by default is
# `deb-systemd-helper enable` and `deb-systemd-invoke start`, so anybody adding
# this token -- which is ordinary, and what Debian policy expects -- would have
# made `apt install netcfgd` enable and start the daemon, contradicting the
# header above with no diff to the header. debian/rules passes
# `--no-enable --no-start` so that the token is now safe to have, which is the
# order those two changes have to happen in.
#DEBHELPER#
