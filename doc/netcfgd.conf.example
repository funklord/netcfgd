##############################################################################
# netcfgd.conf.example -- every feature, with the syntax to use it.
#
# THIS FILE IS NEVER READ. netcfgd loads /etc/netcfgd/netcfgd.conf by that
# exact name, and /etc/netcfgd/conf.d/*.conf by that exact extension. This
# file is neither, so nothing in it takes effect and you can edit, break or
# delete it freely.
#
# It is here for the case the manual is not: a machine with no network, no
# browser and no way to look anything up. Copy the lines you want into
# netcfgd.conf and remove the leading `#`.
#
# Two kinds of comment, and the difference is deliberate:
#
#   # a sentence, with a space after the hash -- prose, like this one
#   #key = "value"           <- no space after the hash: a real example
#
# Every example of the second kind is compiled by the test suite, so what you
# read here is a language netcfgd currently speaks rather than one it used to.
#
# The plan-then-apply loop is the whole product. Nothing below happens because
# you wrote it down:
#
#   ncfg plan      what would change, and why
#   ncfg apply     do it
#   ncfg status    what the machine actually looks like now
#
##############################################################################


##############################################################################
# QUICK START
#
# A wired machine that takes an address from the network. This is the whole
# configuration for most laptops and most servers.

#interface eth0 {
#	config = "dhcp"
#}

# A fixed address, with a default route through the router. `routes` takes
# netifrc's phrasing, because it reads correctly out loud.

#interface eth0 {
#	config = "192.0.2.10/24"
#	routes = "default via 192.0.2.1"
#}

# Both families at once. `config` is a list, and every entry contributes --
# this is composition, not a choice between alternatives.

#interface eth0 {
#	config = ["dhcp", "2001:db8::10/64"]
#	routes = ["default via 192.0.2.1", "default via 2001:db8::1"]
#}

# Wireless, in three parts, and all three are needed.
#
#   `device`    -- policy about the radio: which supplicant, whether to
#                  autoconnect, whether netcfgd touches it at all.
#   `interface` -- the statement that this link's configuration is netcfgd's.
#                  Without it nothing is planned for the radio, because the
#                  planner walks interfaces; a `device` block on its own
#                  compiles and does nothing.
#   `network`   -- a place you sometimes are, rather than hardware you own,
#                  which is why it is separate from both.
#
# This example used to omit the `interface` block, and a configuration written
# from it started no supplicant and joined nothing.

#device wlan0 {
#	wifi {
#		autoconnect = true
#	}
#}
#interface wlan0 {
#	config = "dhcp"
#}
#network "Cafe Wifi" {
#	wifi {
#		psk = "@secret:cafe"
#	}
#}

# The passphrase itself never appears in a config file. `ncfg secret set cafe`
# stores it at 0600, and the config keeps only the reference above. That rule
# has no exceptions anywhere in netcfgd.
#
# `ncfg wifi add "Cafe Wifi"` writes all three for you -- the network, and the
# `device` and `interface` blocks for the radio if it is not already netcfgd's
# -- and asks for the passphrase with the echo off. That is the usual way in.
# On a machine with two radios it asks which, with `--interface`.


##############################################################################
# THE LANGUAGE
#
# Blocks with braces, `key = value` inside them, `#` to the end of the line
# for a comment. No indentation rules, no expressions, no variables, no
# string interpolation. A value is a string, a number, `true`/`false`, a
# secret reference, or a list of those.
#
# Seven blocks exist at the top level:
#
#   interface NAME       what an interface should look like
#   device NAME          the hardware under it, and whether netcfgd touches it
#   network "SSID"       a wireless network you might join, anywhere
#   access_point "SSID"  a network this machine offers to others
#   rule NAME            policy routing, which belongs to no one interface
#   linkset NAME         a group of links, one of which is used at a time
#   global               settings with no interface to attach to
#
# Configuration is /etc/netcfgd/netcfgd.conf, then /etc/netcfgd/conf.d/*.conf
# in filename order. Later files win for a single key. Two files defining the
# same block is an ERROR, not a silent last-wins -- say `override` if you mean
# to replace one wholesale:

#interface eth0 {
#	config = "192.0.2.10/24"
#}
#override interface eth0 {
#	config = "dhcp"
#}

# `override` replaces the block ENTIRELY. It does not adjust one key of it.
# That is the trap worth knowing before you write a drop-in: an `override
# global` containing only a `control` block silently discards the `dns` block
# the file it replaced was carrying, and takes name resolution away from the
# machine in order to change who may open a socket. Edit the block where it
# lives instead, unless replacing all of it is what you want.
#
# `include "/etc/netcfgd/site.conf"` pulls in another file at that point. A
# cycle is refused rather than followed. It is expanded while the directory is
# read rather than by the compiler, which is why it is quoted here rather than
# shown as an example -- the test that compiles everything else in this file
# opens no files and so could not check it.


##############################################################################
# GLOBAL
#
# Name resolution. `mode` decides who writes it; the servers may be set here
# for the whole machine or per interface, and interface scopes win.

#global {
#	dns {
#		mode    = "write_resolv_conf"
#		servers = ["192.0.2.53", "2001:db8::53"]
#		search  = ["example.com"]
#	}
#}

# The modes, and what each one means:
#
#   none                netcfgd does not touch resolution at all
#   write_resolv_conf   it writes /etc/resolv.conf itself
#   resolvconf          it hands servers to whatever provides resolvconf
#   openresolv          openresolv specifically
#   resolved            systemd-resolved
#   dnsmasq             dnsmasq, as a local caching resolver
#   unbound             unbound, likewise
#
# `none` is the default, and it is the right answer on a machine where
# something else already owns /etc/resolv.conf.
#
# What to do when the machine stops matching the configuration. `report` says
# so and changes nothing; it is the default because a daemon that silently
# undoes your `ip` command while you are debugging is worse than one that
# tells you.

#global {
#	on_drift = "report"
#}

# Whether this machine does networking at all. `off` takes every interface
# down and withdraws every address netcfgd owns -- one key rather than a list,
# because it is meant to be usable by a profile that cannot know what this
# machine's interfaces are called.
#
# It is NOT `managed = false`, which means netcfgd does not touch an interface:
# the address it already has stays and the machine keeps talking. This is the
# opposite. Over a network, arm a way back first:
#
#   ncfg apply --confirm-within 60
#
# The shipped `offline` profile is exactly this key. `ncfg profile set offline`.

#global {
#	networking = "off"
#}

# The hostname, from the DHCP lease or pinned here.

#global {
#	hostname = "dhcp"
#}

# Or pinned to a name of your own:

#global {
#	hostname = "kitchen-pi"
#}

# Commit-confirm, for when you are configuring a machine you are logged into
# over the network it is about to reconfigure. An apply arms a timer, in
# seconds; unless `ncfg confirm` follows within it, the machine reverts by
# itself. It covers what netcfgd applies BY ITSELF on noticing this file
# changed, not only `ncfg apply --confirm-within`, so editing the config over
# ssh has the safety net without your having to remember the flag.
#
# Two applies never arm a window. STARTUP, because the fall-back on a machine
# that has never applied is empty, and an unconfirmed window at boot would
# take the network down with nobody present; and a DRIFT correction, because
# putting back what something else changed is not a change anybody waits to
# confirm, and reverting it would leave the machine oscillating.
#
# `ncfg apply --confirm-within 0` is "no window this time" on a machine whose
# config sets the key.

#global {
#	confirm = 120
#}

# WHO MAY ASK NETCFGD FOR WHAT
#
# Three independent tiers, not a ladder:
#
#   observe   ask what the network looks like
#   wifi      scan, join, leave, and add a wireless network
#   admin     change anything else -- apply, reload, revert
#
# Everything defaults to `root`, so a fresh install refuses a desktop client
# and the socket is mode 0600. That is the single most common reason a GUI
# will not connect. This is what opens it:

#global {
#	control {
#		observe = "group:netcfgd"
#		wifi    = "group:netcfgd"
#		admin   = "root"
#	}
#}

# REACHING THIS MACHINE FROM ANOTHER ONE is a separate block, and separate on
# purpose. The tiers above name *principals* -- a user, a group -- checked
# against the credentials of the process on the other end of the socket. A
# caller from off the machine has none netcfgd can see: it arrives through the
# agent, so its credentials are the agent's. A remote policy therefore says
# which tiers reach this machine at all, and not who.

#global {
#	remote {
#		observe = true
#		wifi    = true
#		admin   = false
#	}
#}

# Everything defaults to false, and with all three false netcfgd does not
# create the remote socket at all -- so a machine that has never configured
# remote access has nothing listening for it.
#
# The division: the agent decides who the caller is, netcfgd decides what
# remote can ever do. That bound holds even if the agent is wrong about
# identity, which is the half worth having.
#
# `ncfg control set --observe group:netcfgd --wifi group:netcfgd` writes
# exactly that for you, and `ncfg control show` prints it back. The package
# creates the `netcfgd` group empty; `usermod -aG netcfgd USER` puts somebody
# in it, and they have to log out and back in before the kernel agrees.
#
# A value is `root`, `any`, `user:NAME` or `group:NAME`. The socket's mode
# follows the most permissive tier, so a policy naming a group netcfgd cannot
# reach is refused loudly at startup rather than quietly ignored.


##############################################################################
# INTERFACES
#
# ADDRESSING. `config` is a list and every entry contributes. Order sets the
# route metric where it matters, and nothing else.
#
# The sources, spelled as netcfgd accepts them:
#
#   dhcp, dhcp4         IPv4 from a DHCP server
#   dhcp6, dhcpv6       IPv6 from a DHCPv6 server
#   slaac               IPv6 from router advertisements
#   link-local          169.254/16 or fe80::/10 only
#   reported            whatever a helper outside netcfgd reported for this
#                       interface -- a modem, or a tunnel netcfgd started
#   null                no address at all, which is what a bridge member wants
#   192.0.2.10/24       a literal address, any number of them
#
#   "noop" is deliberately NOT accepted. "keep whatever is there" cannot be
#   reconciled: there would be no state to converge on.

#interface eth0 {
#	config = ["dhcp", "slaac", "192.0.2.10/24"]
#}

# ROUTES. `default via X` or a prefix, optionally with a metric.

#interface eth0 {
#	config = "192.0.2.10/24"
#	routes = [
#		"default via 192.0.2.1",
#		"10.0.0.0/8 via 192.0.2.254",
#	]
#}

# THE REST OF AN INTERFACE.

# A `device` block is the hardware; an `interface` block is what runs over it.
# The split is which side a setting means something on: an MTU means something
# with nothing plugged in, an address does not.

#device eth0 {
#	mtu = 1492
#	mac = "02:00:5e:10:00:01"
#}
#interface eth0 {
#	config      = "dhcp"
#	enabled     = true
#	preference  = 100
#	forwarding  = true
#	on_drift    = "report"
#}

# `preference` is which interface wins when several could carry the default
# route -- lower is better, and it is how a wired cable takes over from wifi.
# `enabled = false` keeps the configuration and leaves the link down.
#
# A radio carries one `preference` whichever network it joined, which is not
# enough to say "the office wifi beats this ethernet, the cafe wifi does not".
# That is a statement about networks, so it is made on the network: see
# `metric` under WIRELESS NETWORKS below.
#
# LINK DETECTION, because carrier is not connectivity. A cable plugged into a
# switch that has lost its own uplink has carrier and no path, and netcfgd used
# to keep preferring it. A probe runs a program on an interval and takes its
# exit status: zero means this link carries traffic. A link that fails
# `down_after` times in a row has its routes withheld exactly as an unplugged
# one does, so the wifi that works stops sitting behind the cable that does not.
#
# `/usr/share/netcfgd/probe/default` is shipped and is an example: it pings two
# public resolvers and the addresses in it are yours to change. Read it before
# using it -- it says why a ping is not enough on a cellular link, and what to
# ask instead.

#interface eth0 {
#	config = "dhcp"
#	probe {
#		command    = "/usr/share/netcfgd/probe/default"
#		args       = ["eth0"]
#		interval   = 30
#		timeout    = 5
#		down_after = 3
#		up_after   = 2
#		hold_down  = 60
#	}
#}

# `down_after` is larger than `up_after` on purpose: one lost packet is not an
# outage, and symmetric counts make a marginal link oscillate at whatever
# `interval` sets. `hold_down` is the dwell -- the earliest a verdict may
# change again -- for a link that flaps faster than the counts can settle.
#
# `require_lease` is on unless you turn it off, and applies only to an
# interface whose `config` asks for DHCP. Such an interface with no lease has
# nothing the probe could succeed over, so netcfgd answers "down" from the
# route table -- a DHCP client stamps `RTPROT_DHCP` on what it installs,
# whichever client it is -- and does not spawn the program at all. Turn it off
# where your client installs routes netcfgd cannot recognise, or none:
# requiring a lease there would hold a working link down for ever.
#
# It is a precondition and not a verdict. A lease means a DHCP server
# answered, which one on a network with a dead uplink does happily -- which is
# the case the probe itself exists for.

#interface wwan0 {
#	config = "dhcp"
#	probe {
#		command       = "/usr/share/netcfgd/probe/default"
#		args          = ["wwan0"]
#		require_lease = false
#	}
#}

# PER-INTERFACE DNS, which beats the global block for names in its domains.

#global {
#	dns { mode = "resolved" }
#}
#interface eth0 {
#	config = "dhcp"
#	dns {
#		servers = ["192.0.2.53"]
#		domains = ["corp.example.com"]
#	}
#}

# NAT, for a machine acting as a router. netcfgd owns exactly one nftables
# table, called `netcfgd`, and does NAT in it and nothing else. It will never
# touch a table it did not create, and never writes a filtering rule.

#interface eth0 {
#	config = "dhcp"
#	nat    = true
#}

# QUEUEING, which is where bufferbloat is fixed. `cake` with the real
# upstream bandwidth is the answer for nearly every home connection.

#device eth0 {
#	qdisc {
#		kind      = "cake"
#		bandwidth = "100mbit"
#	}
#}
#interface eth0 {
#	config = "dhcp"
#}

# A STABLE IPv6 ADDRESS without giving away the hardware address.

#interface eth0 {
#	config      = "slaac"
#	ipv6_token  = "::10"
#}


##############################################################################
# DEVICES -- THE HARDWARE, AND WHETHER NETCFGD TOUCHES IT
#
# HANDING AN INTERFACE TO SOMETHING ELSE. This is the polite exit: netcfgd
# stops operating on the device and changes nothing that is already there.

#device eth1 {
#	managed = false
#}

# The other kind of leaving, for hardware going out of your hands: remove
# everything netcfgd owns first, credentials included, and then let go.

#device eth1 {
#	managed     = false
#	on_unmanage = "clear"
#}

# THE RADIO. `backend` picks the supplicant; `wpa_supplicant` is the one that
# is implemented and covers both wifi and wired 802.1X.

#device wlan0 {
#	wifi {
#		backend             = "wpa_supplicant"
#		autoconnect         = true
#		regdom              = "SE"
#		powersave           = "off"
#		scan_randomization  = true
#		mac_policy          = "per_network"
#		portal_check        = "http://example.com/generate_204"
#	}
#}

# `mac_policy` is the address the radio uses once it has joined something:
#   permanent       the hardware address. Trackable, and what a network with
#                   MAC-based admission control needs.
#   per_network     a fresh address per network, kept for the association and
#                   reused if the radio rejoins within a minute.
#   per_connection  a fresh address every time, including rejoining the same
#                   network. Breaks DHCP reservations and portal sessions.
#
# **Both randomising policies send the same thing to the supplicant**, and what
# separates them is how long the address is kept. The per-network `mac_addr`
# key has exactly three values -- the permanent address, a random one per
# connection, and a random one that keeps the manufacturer prefix -- so there
# is no value meaning "every time". The freshness comes from the supplicant's
# `rand_addr_lifetime`, 60 seconds by default, which netcfgd sets from this
# policy: 60 for `per_network` and 0 for `per_connection`.
#
# netcfgd sent the third value for `per_connection` until 0230, which kept the
# manufacturer prefix -- so the policy documented here as the strongest was the
# one that said who made the radio.
#
# The prefix-keeping value is not offered. Admitting by vendor is a real thing
# to want, but it is a third policy rather than a stronger second one, and
# nothing has asked for it.
#
# **`scan_randomization` is the other half, and the more exposed one.**
# `mac_policy` governs the address used once a network is joined; this governs
# the address in *probe requests*, which are broadcast to everyone in range
# whether or not anything is ever joined -- a laptop walking through a station
# announcing the same address to every receiver it passes.
#
# It sets the supplicant's `preassoc_mac_addr`, and netcfgd sends it in both
# directions rather than leaving it unset: an unset global inherits whatever
# this distribution's supplicant defaults to, and a privacy property that
# depends on somebody else's default is not a property.
#
# It was accepted and inert until 0220, and `ncfg plan` said so on every apply.
#
# **Setting `mac` on the device and a randomising `mac_policy` contradict each
# other**, and netcfgd does both: the fixed address holds until the radio
# associates and not after. `ncfg plan` warns.
#
# **Half of 5 GHz is shared with radar, and costs a wait.** Channels 52 to 64
# and 100 to 144 need a channel availability check before an access point may
# beacon on them: the radio listens first, typically for a minute and longer on
# some channels, and sends nothing until it is done. `ncfg apply` returns as
# soon as hostapd is started, so an access point on one of those channels is
# configured, running and silent for a while -- which looks exactly like one
# that is broken. `ncfg plan` says so.
#
# They are worth using anyway: they are the half of 5 GHz that is usually
# empty. Channels 36 to 48 and 149 upwards need no wait.
#
# netcfgd writes `ieee80211h=1` beside the country code, which is what enables
# radar detection at all -- hostapd defaults it off and documents DFS support
# as "required on outdoor 5 GHz channels in most countries of the world". It
# did not until 0232, so a DFS channel was configurable and could not work.
# Both lines go together because hostapd says `ieee80211h` "can be used only
# with ieee80211d=1", and that is written from `regdom` -- so **an access point
# with no `regdom` has no radar detection either**, which is one more reason to
# set one.

# **`band` and `channel` have to agree, and now say so at compile time.**
# 2.4 GHz is channels 1-14 and 5 GHz is 36-177. `band = "2.4"` with
# `channel = 36` used to compile and plan cleanly and fail at `ncfg apply`,
# with the interface already up; it is a config error now, at the line.
#
# Leave `channel` out to let hostapd survey the band and choose -- that is
# written as `channel=0`, which is what "automatic" is spelt as. Leave `band`
# out as well and the channel number decides; leave out both and it is 2.4 GHz,
# which every radio has.
#
# **What this build does not write is any of `ieee80211n`, `ieee80211ac` or
# `wmm_enabled`.** hostapd defaults them off, so an access point netcfgd starts
# runs at 802.11a/g rates -- 54 Mbps -- whichever band it is in. Nothing is
# wrong with the configuration; it is simply not a fast access point, and the
# reason is worth knowing before measuring throughput and blaming the radio.

# **`regdom` here is not the one that does anything, and that is a trap worth
# knowing about.** The language spells `regdom` in two places:
#
#   device wlan0 { wifi { regdom = "SE" } }    stored, and not acted on
#   access_point "Home" { regdom = "SE" }      written, as hostapd's country_code
#
# The radio's is kept in the document and reaches nothing. The access point's
# becomes `country_code` in the generated hostapd configuration, which hostapd
# documents as "used to set regulatory domain". So the setting that reads as
# belonging to the hardware is the inert one, and a machine whose two blocks
# disagree gets the access point's. `ncfg plan` warns on both cases.
#
# **What the radio is actually permitted to do is the kernel's answer, and
# netcfgd does not observe it.** `iw reg get` is where to look, and it has two
# halves that can differ:
#
#   global
#   country 00: DFS-UNSET          <- the world domain, the default
#
#   phy#0 (self-managed)
#   country SE: DFS-UNSET          <- what this radio is actually using
#
# A *self-managed* phy carries its own domain from the driver's firmware --
# iwlwifi does -- and the kernel does not let a user-space country code move
# it. On such a radio neither `regdom` changes anything at all, and the one
# that matters was decided before the machine booted. On everything else, the
# world domain is what a machine gets when nothing sets one, and it marks much
# of 5 GHz "no IR": the radio may not initiate radiation, which is what a
# beacon is, so an access point there will not start.
#
# `ncfg plan` deliberately does not predict which of those you have. It says
# which `regdom` netcfgd writes and which it drops, because that is the part
# netcfgd knows.

# `portal_check` is what notices a captive portal instead of reporting a
# working network that resolves nothing.
#
# **The URL has to answer `204`, and nothing can check that for you.** That is
# what a `generate_204` endpoint is for: an empty body and a status no portal
# will produce by accident. netcfgd asks for the URL and calls anything that is
# not a 204 a portal -- so an endpoint that answers `200`, which most ordinary
# pages do, reports a captive portal on every join of a perfectly good network
# and runs the hook each time. The message says which number it got, so the
# mistake announces itself, but it is worth not making.
#
# It must be `http`, and the compiler refuses `https` by name: a portal works
# by intercepting the request, which is the one thing TLS prevents, so an
# `https` probe reports no portal on exactly the networks it is for.
#
# The check fires once per joining -- when the interface gains a routable
# address, having not had one -- rather than on a timer. Where it cannot be
# completed at all, because nothing routes yet or the name does not resolve,
# netcfgd retries a few times and then says it has given up: an answer that was
# not an answer must not be mistaken for "checked, and clear".
#
# THE MODEM. Which SIM source to use, and which APN to ask for (0150).

#device wwan0 {
#	modem {
#		sim = ["esim", "socket"]
#		apn = "im.cxn"
#	}
#}

# `sim` is ordered rather than a preference plus a fallback: "which one do you
# want, and what next" is one statement, and two settings could disagree. The
# names are your board's -- netcfgd does not interpret them, it hands them to
# a `pre_up` hook, which is the only thing that knows what a mux select line
# does. Driving that line is board enablement and netcfgd has no GPIO.
#
# The APN cannot be guessed and netcfgd does not try. It is not on the card --
# an APN Control List is a restriction rather than a directory, and on the
# board this was measured against it was empty with the service not activated.
# It is not in an offline carrier database either, which carries public APNs
# only. And asking for one your subscription does not carry gets the network's
# own default rather than an error, so a wrong APN looks like a working attach
# and only a probe of the thing you actually need will tell you otherwise.
#
# `apn` is a REQUEST, and the network answers as it pleases. Measured on one
# board, same SIM, two attaches four minutes apart: one asked for `im.cxn` and
# was granted `internet.cxn`, the next asked for `internet.cxn` and was granted
# `im.cxn`. The addresses came from different pools, so the grant genuinely
# differed rather than the report being stale. What decides it is not known.
# The helper reads the APN in force back with `AT+CGCONTRDP` and says so --
# never `AT+CGDCONT?`, which reads back the request it wrote a moment earlier
# and would agree with itself on a link that had been substituted out from
# under it.
#
# A CELLULAR INTERFACE TAKES ITS ADDRESS FROM THE LEASE AND ITS NAMESERVERS
# FROM NOWHERE. Note what this block does not have.

#interface wwan0 {
#	config = "dhcp"
#	probe {
#		command = "/usr/share/netcfgd/probe/default"
#		args    = ["wwan0"]
#	}
#}

# On an ECM module the host takes an ordinary DHCP lease -- the module bridges
# the operator's address -- so `config = "dhcp"` is right. **But the same DHCP
# offers nameservers, and on the module measured they answer nothing at all:
# `192.168.10.3` and `.4`, on the module's own pre-attach subnet.** The
# resolvers that work are the ones the network put in the PDP context, they
# change with the APN, and nothing outside the modem can know them in advance.
#
# An interface takes its lease's nameservers only where it carries a `dns { }`
# block, so leaving that block off -- as above -- is how you say "the address,
# not the resolvers". An interface that has one here comes up addressed,
# routed and unable to resolve, which reads as an outage rather than as a
# configuration choice.
#
# And the `probe` is not decoration. A cellular link that pings is not a
# cellular link that works: on the default APN a network hands out when it does
# not like the one requested, ICMP succeeds everywhere and the well-known
# resolvers accept connections while every other address blackholes the SYN.
# The bearer is up, the modem says so, and nothing useful crosses it. Only
# fetching something real separates the two.
#
# ETHERNET OFFLOADS AND LINK SETTINGS, for a NIC whose defaults are wrong.
# Each toggle is "on", "off" or "unmanaged" -- three values rather than two,
# because "leave this one alone" is a different instruction from "turn it
# off", and a boolean could not say it.

#device eth0 {
#	ethtool {
#		autoneg      = "on"
#		gro          = "on"
#		gso          = "on"
#		tso          = "on"
#		rx_checksum  = "on"
#		tx_checksum  = "on"
#		wol          = "off"
#	}
#}
#interface eth0 { config = "dhcp" }

# AN ACCESS POINT. netcfgd generates hostapd's configuration under /run and
# runs it. It needs an `interface` block for the same radio: that is what
# brings the device up and starts hostapd on it, and an `access_point` block
# on its own plans nothing at all.

#access_point "Home" {
#	device  = "wlan0"
#	channel = 36
#	band    = "5"
#	regdom  = "SE"
#	hidden  = false
#	wifi {
#		psk = "@secret:ap"
#	}
#}
#interface wlan0 {
#	config = "192.168.4.1/24"
#}

# THE ADDRESS IS NOT OPTIONAL, and netcfgd cannot supply what comes after it.
#
# hostapd broadcasts and stations associate; that is the whole of what an
# access point does. A station that has associated still needs an address, a
# route and a resolver, and **netcfgd serves no DHCP** -- `dnsmasq` appears in
# this file only as a `dns_mode`, which writes resolver configuration and
# hands out nothing.
#
# So `interface wlan0 { }` with no `config` gives a radio that beacons and a
# station that associates and can then reach nothing. Give the interface a
# static address as above, and either run a DHCP server on it yourself or
# configure the stations by hand. `ncfg plan` warns about the address; nothing
# can warn about the server, because netcfgd cannot see one it does not run.
#
# Sharing an uplink additionally needs `forwarding` on and a `nat` rule, both
# of which netcfgd does have -- see the sections for them.

# **`hidden` on an access point is not a security measure**, and netcfgd does
# not treat it as one. It suppresses the name in beacons, which keeps the
# network out of a list of nearby networks and does nothing else: the name is
# still in every association, and every client that knows it now broadcasts it
# while probing, wherever they are. It is worse than the problem for most
# people, and it is offered because sometimes a network has to be set up to
# match one that already exists.
#
# Who may associate with it. One list or the other, never both, because
# hostapd reads one file or the other.

#access_point "Home" {
#	device = "wlan0"
#	wifi {
#		psk = "@secret:ap"
#	}
#	access_control {
#		deny = ["00:11:22:33:44:55"]
#	}
#}

# `ncfg wifi clients` lists who is actually associated, and marks a station
# that is on the deny list and connected anyway -- which happens because
# hostapd holds the list it read at startup.


##############################################################################
# WIRELESS NETWORKS
#
# A `network` block is a place, not a piece of hardware. It applies to
# whichever radio is in range of it.
#
# WPA2 or WPA3 with a passphrase. The passphrase is a reference; the value
# lives in the secret store.

#network "Home" {
#	metric = 100
#	wifi {
#		psk = "@secret:home"
#	}
#}

# An open network, stated rather than implied -- so that a typo in `psk`
# cannot quietly produce one.

#network "Airport Free Wifi" {
#	wifi {
#		open = true
#	}
#	metered = true
#}

# RANKING A NETWORK AGAINST A WIRED LINK.
#
# `metric` is what this network's routes get while the machine is on it, and
# it is compared against every other link's `preference` on the same scale --
# lower is better, both are route metrics. So a network can be declared better
# than a cable, or worse than one, without the radio having to be either.

#interface eth0 {
#	config     = "dhcp"
#	preference = 100
#}
#network "Office" {
#	metric = 50
#	wifi { psk = "@secret:office" }
#}
#network "Cafe" {
#	metric = 600
#	wifi { psk = "@secret:cafe" }
#}

# On "Office" the wifi carries the default route (50 beats eth0's 100); on
# "Cafe" the cable does (100 beats 600). The radio never changed.
#
# `metric` answers both senses of "which network do I prefer": it ranks this
# network's routes against every other link, and it decides which network to
# join when several are in range. netcfgd derives what the supplicant needs
# from it, so there is one number and one direction.
#
# A network used to carry a separate `priority` for the joining half, running
# the other way up. It was retired: two numbers, opposite directions, one idea,
# and each could only be documented in terms of the other. A configuration
# still naming it is told what to write instead -- and told that the number
# must be inverted rather than copied.
#
# A network with no `metric` leaves its interface's `preference` alone, which
# is what every configuration written before this existed does.

# A hidden network has to be probed for by name: without `hidden = true` it is
# never probed for, so it simply never appears and nothing says why.
#
# **What `hidden` costs on this end.** Probing by name means sending the name,
# in the clear, from wherever this machine happens to be -- so a laptop
# configured for a hidden network announces it in every airport it passes
# through. That is the trade, and it is the opposite way round from how hiding
# is usually described.

#network "Backroom" {
#	wifi {
#		psk = "@secret:backroom"
#	}
#	hidden = true
#}

# Pinning a generation, where a network offers both and one of them misbehaves.
#
# `proto` is `"wpa2"`, `"wpa3"` or `"wpa2wpa3"` -- also spelled `"wpa2+wpa3"` --
# and the default is the last of those: offer both and let the access point
# choose, which is what joins a network in transition mode without being told
# about it. Management frame protection follows from the choice and is not a
# setting: required for `wpa3`, optional for the other two, because requiring
# it excludes a WPA2 access point and forbidding it excludes SAE.
#
# **OWE is a third answer to "is this network secured", and scans used to give
# two.** Opportunistic wireless encryption asks for no credential and encrypts
# anyway -- so `ncfg wifi scan` said `open`, which is the word for a network
# that does neither. Joining them is not the same thing: OWE is its own key
# management with management frame protection required, and an `open = true`
# block against such an access point does not associate.
#
# The scan says `owe` now, and so do the TUI, the GUI and the NetworkManager
# shim. Writing one is:
#
#   network "guest" {
#   	wifi { owe = true }
#   }
#
# **`ncfg wifi add` cannot write that yet**, and neither can the GUI's add
# dialog -- the request carries a passphrase, a generation and an 802.1X arm,
# with no third state between "a credential" and "none". The GUI says so and
# prints the block rather than writing an open one that never connects.

# **How SAE derives its password element is netcfgd's choice, not yours.**
# There are two mechanisms -- the original hunting-and-pecking loop and the
# newer hash-to-element -- and wpa_supplicant offers only the first by default
# (`sae_pwe=0`). A station on that default cannot complete SAE with an access
# point configured for hash-to-element only, and the handshake simply does not
# finish: there is no error naming the cause.
#
# netcfgd sends `sae_pwe 2`, which is both, for every radio it populates. It
# costs one command, affects nothing but an SAE handshake, and is the value
# wpa_supplicant's own documentation expects to become the default. There is no
# key here to set because there is no reason to want less.
#
# **netcfgd's own access points do not offer it**, which is the asymmetry. A
# station takes it over the control socket, where a supplicant too old to know
# the setting answers `FAIL` and carries on; hostapd takes its configuration
# from a file, and an unknown key there stops it from starting at all. Adding
# the line would make every access point depend on hostapd 2.10 with nothing
# able to check the version at the time the file is written. So a netcfgd
# access point cannot serve a client that does hash-to-element only -- rare,
# and recorded rather than traded for that.

# **`wpa3` alone lifts the passphrase length limit**, and that is a property of
# the field rather than of WPA. A WPA2 passphrase goes in `psk`, which takes 8
# to 63 **octets**; WPA3 sends it as `sae_password`, which has no such range.
# Transition mode keeps the limit, because it has to produce something `psk`
# will accept as well.
#
# **Octets, not characters**, and the difference is only visible if your
# passphrase leaves ASCII. Both wpa_supplicant and hostapd count bytes, so a
# passphrase of 32 accented letters is 64 octets and is refused -- hostapd says
# `invalid WPA passphrase length 64 (expected 8..63)` -- while four accented
# letters is eight octets and is accepted. netcfgd counted characters in four
# separate places until 0229, so it allowed the first and refused the second,
# and both mistakes only showed up at the daemon.

#network "Home" {
#	wifi {
#		psk   = "@secret:home"
#		proto = "wpa3"
#	}
#}

# ENTERPRISE (802.1X), for a campus or a corporate network. The same block
# works on a wired interface, which is why the supplicant is not wifi-only.

#network "eduroam" {
#	wifi {
#		eap                 = "peap"
#		identity            = "you@example.ac.uk"
#		anonymous_identity  = "anonymous@example.ac.uk"
#		password            = "@secret:eduroam"
#		ca_cert             = "/etc/netcfgd/certs/example-ac-uk.pem"
#		domain_suffix_match = "radius.example.ac.uk"
#		phase2              = "auth=MSCHAPV2"
#	}
#}

# **`phase2` is `key=value`, and a bare method name pins nothing.** This line
# used to read `phase2 = "mschapv2"` here, which is the inert form: the
# supplicant stores whatever it is given -- it answers OK to `phase2 =
# "nonsense"` -- and picks an inner method by looking for `auth=` and
# `autheap=`. A value with neither leaves the inner method unconstrained, so
# the server proposes and the supplicant accepts. Pinning `auth=MSCHAPV2` is
# what stops a server asking for `GTC`, which sends the password in clear
# inside the tunnel. netcfgd refuses a malformed one now rather than passing it
# through.
#
# `auth=` for a password method carried inside the tunnel, `autheap=` where the
# inner method is itself EAP.
#
# **TWO FIELDS, AND BOTH ARE LOAD BEARING.** `ca_cert` says who signed the
# server's certificate. `domain_suffix_match` says who that certificate is
# for. With only the first, every certificate that issuer ever signed is
# accepted -- which is the whole point when the issuer is the organisation's
# own CA, and nearly worthless when it is a public one.
#
# This example used to pin `/etc/ssl/certs/ca-certificates.crt`, the system
# bundle. That means "trust every public CA on earth": anybody who can buy a
# certificate raises an access point with the right name, is believed, and
# takes what the inner method sends -- an MSCHAPv2 exchange to crack offline,
# or the password itself. Pin the issuer your organisation actually uses, and
# name the server. `ncfg plan` warns while either is missing.
#
# A suffix matches downward: `example.ac.uk` accepts any host under it, and
# `radius.example.ac.uk` accepts that one. Ask whoever runs the network which
# to use; guessing wide defeats the point of setting it.

# Certificate authentication instead of a password. The three certificate
# fields each take either a path to a file already on this machine:

#network "corp" {
#	wifi {
#		eap                 = "tls"
#		identity            = "you@corp.example"
#		ca_cert             = "/etc/netcfgd/certs/corp-ca.pem"
#		domain_suffix_match = "radius.corp.example"
#		client_cert         = "/etc/netcfgd/certs/you.pem"
#		private_key         = "/etc/netcfgd/certs/you.key"
#	}
#}

# ...or a reference to content netcfgd holds, stored with `ncfg secret set`:

#network "corp" {
#	wifi {
#		eap                 = "tls"
#		identity            = "you@corp.example"
#		ca_cert             = "@secret:corp-ca"
#		domain_suffix_match = "radius.corp.example"
#		client_cert         = "@secret:corp-crt"
#		private_key         = "@secret:corp-key"
#	}
#}

# The two are not interchangeable and the difference is who has to be able to
# read the file.
#
# A PATH is an instruction to open a file as root, so netcfgd treats it as
# privileged: a client that is not root cannot send configuration containing
# one. It is the right form when the certificates are already on the machine
# and an operator manages them.
#
# STORED CONTENT is something netcfgd already has, because somebody gave it:
#
#   ncfg secret set corp-ca   < /path/to/ca.pem
#   ncfg secret set corp-key  < /path/to/client.key
#
# netcfgd writes it under /run at 0600 when wpa_supplicant needs it, and hands
# over that path. Nothing on your disk has to be readable by root, and a
# desktop client can set up an enterprise network without being root -- which
# a path can never allow.

# Pinning one access point, where several share an SSID and one of them is
# the one you want.

#network "Home" {
#	wifi {
#		psk = "@secret:home"
#	}
#	bssid = "00:11:22:33:44:55"
#}

# **A block with `bssid` and no `ssid` learns the name from a scan, and a
# hidden access point will not tell it.** Naming the radios and leaving the
# network name out is allowed -- netcfgd reads the name off the last scan when
# it hands the network to the supplicant. A hidden access point advertises an
# empty name, which is what hiding is, so there is nothing to read. netcfgd
# says so rather than joining under the empty name it was given:
#
#   the access points `Home` names are in range and hidden, so a scan cannot
#   say what the network is called: 00:11:22:33:44:55. Write the name in the
#   block -- `ssid = "..."` -- and keep `bssid` to pin which radios it may use
#
# Write both, and set `hidden = true` as well so the radio probes for it.

# ROAMING between access points sharing an SSID. `signal` is the dBm below
# which it starts looking for something better.
#
# **What a roam costs is netcfgd's business too, and it used to be left at the
# supplicant's default.** This block is what makes the radio look for somewhere
# better, so it is what decides how often a move happens -- and on an
# enterprise network a move means a full exchange with the authentication
# server unless the pairwise key can be carried to the new access point.
#
# Opportunistic key caching is what carries it, and wpa_supplicant leaves it
# off. netcfgd turns it on for every radio it populates. Where the access
# points do not share a key it changes nothing: the station offers a key id,
# the access point does not recognise it, and a full authentication happens
# exactly as before. There is no key here to set, because there is no reason
# to want the expensive answer.
#
# Nothing is written about rekeying. hostapd's defaults are already right --
# the group key is rotated daily with CCMP -- and the pairwise key is the
# supplicant's and the access point's to manage between them.

#network "Campus" {
#	wifi {
#		psk = "@secret:campus"
#		roam {
#			signal        = -75
#			interval      = 10
#			slow_interval = 60
#		}
#	}
#}


##############################################################################
# LINK TYPES
#
# A BRIDGE. Members take no address of their own; the bridge does.

#device br0 {
#	bridge {
#		members         = ["eth0", "eth1"]
#		stp             = true
#		forward_delay   = 4
#		vlan_filtering  = false
#	}
#}
#interface br0 {
#	config = "192.0.2.10/24"
#	routes = "default via 192.0.2.1"
#}

# A BOND, for two cables to one switch.

#device bond0 {
#	bond {
#		members = ["eth0", "eth1"]
#		mode    = "802.3ad"
#		miimon  = 100
#	}
#}
#interface bond0 {
#	config = "dhcp"
#}

# A VLAN. The parent is the physical interface; the id is the tag.

#device vlan10 {
#	vlan {
#		parent = "eth0"
#		id     = 10
#	}
#}
#interface vlan10 {
#	config = "dhcp"
#}

# WIREGUARD. The private key is a secret reference like every other
# credential; the peers each carry a public key, which is not secret.

#device wg0 {
#	wireguard {
#		private_key = "@secret:wg0"
#		listen_port = 51820
#		peer "office" {
#			public_key   = "xTIBA5rboUvnH4htodjb6e697QjLERt1NAB4mZqp8Dg="
#			endpoint     = "vpn.example.com:51820"
#			allowed_ips  = ["10.9.0.0/24", "192.168.50.0/24"]
#			keepalive    = 25
#		}
#	}
#}
#interface wg0 {
#	config = "10.9.0.2/24"
#}

# A PERSISTENT TUN OR TAP DEVICE, for something else to attach to: a VPN
# daemon, a hypervisor, a test rig. `tun` carries IP packets and `tap` carries
# ethernet frames, and the block's name is which one you get.
#
# `owner` and `group` are who may attach to it. Without them only root can,
# which is the kernel's default rather than netcfgd's choice.
#
# This is the one link netcfgd does not make over netlink: tun and tap come
# from a TUNSETIFF ioctl on /dev/net/tun. That is invisible from here and is
# the reason the kind was in the schema and unimplemented until netcfgd grew
# the one syscall for it.

#device tun0 {
#	tun {
#		owner = "openvpn"
#	}
#}
#interface tun0 {
#	config = "10.8.0.1/24"
#}

# A VXLAN overlay.

#device vx0 {
#	vxlan {
#		id     = 100
#		parent = "eth0"
#		local  = "192.0.2.10"
#		remote = "198.51.100.10"
#		port   = 4789
#	}
#}
#interface vx0 {
#	config = "10.20.0.1/24"
#}

# A GRE OR IPIP TUNNEL.

#device gre0 {
#	tunnel {
#		mode   = "gre"
#		local  = "192.0.2.10"
#		remote = "198.51.100.10"
#		ttl    = 64
#	}
#}
#interface gre0 {
#	config = "10.30.0.1/30"
#}

# A MACVLAN, which gives a container its own hardware address on the LAN.

#device mv0 {
#	macvlan {
#		parent = "eth0"
#		mode   = "bridge"
#	}
#}
#interface mv0 {
#	config = "dhcp"
#}

# A VRF, for keeping one set of routes away from another.

#device mgmt {
#	vrf {
#		table = 100
#	}
#}
#interface mgmt {
#	config = "192.0.2.10/24"
#}

# A DUMMY interface, which is the usual home for a stable service address.

#device dummy0 {
#	kind   = "dummy"
#}
#interface dummy0 {
#	config = "192.0.2.1/32"
#}

# A VETH PAIR, for handing one end to a namespace or a container.

#device veth0 {
#	veth {
#		peer = "veth1"
#	}
#}
#interface veth0 {
#	config = "10.40.0.1/24"
#}

# PPPoE, which is how a good many DSL connections still work.

#device ppp0 {
#	pppoe {
#		parent   = "eth0"
#		username = "user@isp.example"
#		password = "@secret:isp"
#	}
#}
#interface ppp0 {
#	config = "reported"
#}

# AN OPENVPN TUNNEL, configured by the file OpenVPN already understands.
# netcfgd starts it and takes the address it reports.

#device tun0 {
#	openvpn {
#		config   = "/etc/openvpn/client.conf"
#		username = "you"
#		password = "@secret:vpn"
#	}
#}
#interface tun0 {
#	config = "reported"
#}


##############################################################################
# LINKSETS -- ONE LINK AT A TIME
#
# A `linkset` is a named group of links that can stand in for each other, and
# netcfgd uses one of them at a time. A cable and a modem, a cable and the
# office wifi, two cables to two providers: the sentence is always "these can
# reach the same place, use the best one that actually works".
#
# A member is an interface, a `network` block by name, or another linkset.
# That last one is what makes the group a link in its own right.

#interface eth0 {
#	config = "dhcp"
#	preference = 100
#}
#interface wwan0 {
#	config = "dhcp"
#	preference = 700
#}
#network "office" {
#	wifi { psk = "@secret:office" }
#	config = "dhcp"
#	metric = 300
#}
#linkset "uplink" {
#	members = ["eth0", "office", "wwan0"]
#}

# THE ONE IN USE is the eligible member with the lowest metric -- an
# interface's `preference`, a network's `metric` -- and where two cannot be
# told apart, the one written first. A member is eligible when the link
# carrying it has carrier and has not failed its `probe`, which are the same
# two facts `preference` already acts on.
#
# An absent metric reads as 0, which is the STRONGEST. That is the kernel's
# own reading of an unnumbered route, and it is why writing a metric on one
# member and not another demotes the one you wrote.
#
# WHAT IT DOES: the chosen member gets its routes and the others do not.
# A spare holding a default route at a worse metric is not a spare -- it is a
# second path the kernel falls back to on its own, with nothing having decided
# that it works. `ncfg status` prints each set, what it chose, and why each
# other member is not carrying anything.
#
# THE SET CALLED `uplink` IS SPECIAL, by that name and nothing else: it is the
# one that carries the default route, and it is what netcfgd means by
# "connected" -- the tray icon, `ncfg wait-online`, and the `connectivity`
# block in `global` all follow it. Declare it narrowly and you have said that
# a machine reaching the network any other way is not connected, which is a
# reasonable thing to say and worth saying on purpose.
#
# Any other name is an ordinary set: it chooses one member and withholds the
# rest's routes, and it says nothing about what "connected" means.


##############################################################################
# THE ROUTER SIDE
#
# HANDING OUT PREFIXES. A router takes a prefix by DHCPv6 prefix delegation
# and gives pieces of it to the networks behind it.

#interface eth0 {
#	config = ["dhcp", "dhcp6 pd"]
#}

# The inside interface takes a piece of what the outside one was delegated,
# and advertises it.

#interface br0 {
#	config = ["192.168.1.1/24", "@pd:0::1/64"]
#	advertise {
#		backend  = "radvd"
#		prefixes = ["@pd:eth0"]
#		managed  = false
#		other    = false
#		lifetime = 1800
#		dns      = true
#	}
#}

# POLICY ROUTING. A rule sends some traffic to a different table -- which is
# how a second uplink, or a VPN for one subnet only, is expressed.

#rule "vpn-subnet" {
#	family   = "ipv4"
#	from     = "192.168.50.0/24"
#	lookup   = 100
#	priority = 1000
#}

# The same shape, refusing traffic rather than redirecting it.

#rule "quarantine" {
#	family   = "ipv4"
#	from     = "192.168.99.0/24"
#	action   = "unreachable"
#	priority = 1100
#}


##############################################################################
# DHCP DETAIL
#
# The client is dhcpcd or udhcpc, not netcfgd -- there is no DHCP client built
# in, deliberately, and there is no `dhcp` block either. What a DHCP entry
# carries are modifiers written after it in the addressing entry, the same way
# a literal address carries them.
#
# On the v6 side those modifiers are what ask for a delegated prefix. `pd`
# alone takes whatever the ISP offers:

#interface eth0 {
#	config = ["dhcp", "dhcp6 pd"]
#}

# Or say what to ask for. Each of these implies `pd`, so a length without it
# cannot be silently inert:

#interface eth0 {
#	config = ["dhcp", "dhcp6 pd_length 56"]
#}

# A literal address takes modifiers in netifrc's phrasing. This build accepts
# netmask, peer, preferred_lft and valid_lft; `ncfg plan` names any it does
# not, rather than ignoring one:

#interface eth0 {
#	config = "192.0.2.10/24 valid_lft 3600 preferred_lft 1800"
#}

# And SLAAC takes the privacy setting, which is where RFC 4941 temporary
# addresses are turned on:

#interface eth0 {
#	config = "slaac privacy prefer_temporary"
#}


##############################################################################
# HOOKS -- RUNNING SOMETHING WHEN THE NETWORK CHANGES
#
# A hook body is shell. It ends at the first line that is nothing but a
# closing brace -- and braces inside the shell DO matter, because netcfgd
# does not parse what is in a hook and so cannot tell your braces from its
# own. A shell function must therefore keep its closing brace off a line of
# its own:

#interface eth0 {
#	post_up {
#	greet() { echo hello; }
#	greet
#	}
#}

# Spread over three lines, the lone `}` ends the hook there and everything
# after it is read as configuration -- which fails somewhere else entirely,
# talking about `=` and `{` at a line you wrote shell on.
#
# The phases are pre_up, up, post_up, pre_down, down and post_down, plus five
# events, which are written with `on` in front of them:
#
#   on carrier   carrier gained or lost
#   on lease     a lease acquired, renewed or lost
#   on roam      the station moved to another access point
#   on portal    a captive portal was detected
#   on drift     the machine stopped matching this document
#
# All eleven fire in this build.
#
# THE ORDERING TRAP, learned from netifrc: `pre_up` runs BEFORE the link is
# up, so anything in it that needs the network will fail. Use `post_up` for
# that, which is what almost everybody means.

#interface eth0 {
#	config = "dhcp"
#	post_up {
#		logger -t netcfgd "eth0 is up with $NCFG_ADDRESSES"
#	}
#}

# The environment a hook gets is prefixed `NCFG_`.
#
# A HOOK RUNS AS ROOT. There is no way to ask for anything else: netcfgd's
# hook runner will drop to a named user and will kill a hook that overruns,
# and the configuration language has no key for either, so nothing you can
# write here reaches them.
#
# This file used to show `run_as=nobody` and `timeout=30` as the first two
# lines of a hook body, as though they were settings. They are not. A hook
# body is shell and nothing reads it but the shell, so those two lines set
# two shell variables, and the hook runs as root with the default 60-second
# limit exactly as it would without them. The example is gone rather than corrected in place,
# because a wrong one is worse than none: it was read as privilege being
# dropped where none was.
#
# So: anything able to write config into /etc/netcfgd can run code as root,
# whatever the file's mode says -- which is why the directory is root's, and
# why `ncfg wifi add` takes typed fields over a socket rather than a file
# somebody wrote.

#interface eth0 {
#	config = "dhcp"
#	post_up {
#	/usr/local/bin/announce-address
#	}
#}


##############################################################################
# SECRETS
#
# A credential is never written in a config file. `@secret:NAME` is a
# reference, and the value lives in /etc/netcfgd/secrets/NAME at 0600, put
# there by:
#
#   ncfg secret set NAME
#
# which asks with the echo off, or reads standard input. Removing one is
# `rm`. `@secret:provider:NAME` names a provider other than the default,
# where one is configured.
#
# This holds for every credential netcfgd knows: wifi passphrases, 802.1X
# passwords and private keys, WireGuard private keys, PPPoE and VPN logins.
# The desired-state document that `ncfg show` prints and /run/netcfgd holds
# never contains secret material, only the references.


##############################################################################
# WHERE TO GO NEXT
#
#   ncfg plan                 what would change, and why, in full
#   ncfg explain interface X  why does this interface look like this?
#   ncfg status               what the machine looks like now
#   ncfg monitor              watch it change, live
#   ncfg tui                  all of the above, full screen
#
# doc/first-run.md walks a laptop from NetworkManager to netcfgd, wired
# first. `ncfg plan` before every `ncfg apply` is the habit this whole tool
# is shaped around.
#
# IF NETCFGD IS THE PROBLEM AND YOU WANT NETWORKMANAGER BACK, this is the
# whole of it, and it needs no network:
#
#   systemctl disable --now netcfgd netcfgd-nm
#   systemctl enable --now NetworkManager
#   rm -f /etc/systemd/system/netcfgd.service.d/netcfgd-exclusive.conf
#
# Use `disable` rather than `stop`: netcfgd restarts on failure, and a
# crash-looping netcfgd would take the bus name back. Nothing about the
# switch removes or overwrites a file of NetworkManager's, and its own
# profiles under /etc/NetworkManager/system-connections are never touched by
# netcfgd, so it comes back knowing every network it knew.
##############################################################################
