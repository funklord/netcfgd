#!/bin/sh
# A modem helper for netcfgd, over MBIM, with no bus and no ModemManager.
#
#     netcfgd-modem-mbim monitor    -d /dev/cdc-wdm0 -i wwan0 -a internet
#     netcfgd-modem-mbim connect    -d /dev/cdc-wdm0 -i wwan0 -a internet
#     netcfgd-modem-mbim disconnect -d /dev/cdc-wdm0 -i wwan0
#     netcfgd-modem-mbim stop       -i wwan0
#
# `monitor` is the one to run from a service manager: it connects, then stays
# up watching the bearer, and empties the report the moment the network drops
# it. `connect` is the same thing without the watching, which leaves a report
# nothing maintains -- fine for a script that is about to do its own polling,
# and a trap for anything else. A stale report means netcfgd keeps an address
# and a default route on a modem that is gone, and a default route down a dead
# modem black-holes traffic another interface would have carried.
#
# netcfgd does not start this, supervise it or speak to it. It connects a
# cellular bearer and writes what the network gave it to
# `/run/netcfgd/reported/<interface>`; netcfgd reads that file and configures the
# interface from it. `doc/interface-report.md` is the whole contract between the
# two, and this script is one implementation of the writing half -- decision
# 0045 is explicit that it is not a privileged one. `umbim` on OpenWrt is the
# other obvious way, on hardware where libmbim does not fit.
#
# It does NOT configure the interface. That is netcfgd's job, and two writers
# on one interface is the failure the whole arrangement exists to avoid. Set
# `config = "reported"` on the interface and netcfgd installs the address, the
# default route and the nameservers from the report.
#
# What it needs: `mbimcli` from libmbim-utils, and read/write on the modem's
# control device. No D-Bus, no systemd, no ModemManager -- mbimcli links
# neither libdbus nor libsystemd and talks to /dev/cdc-wdmX and nothing else.
#
# The APN comes from netcfgd's document. That was the other way round until
# decision 0150, which the copyright holder settled: the APN is provisioning
# data, it cannot be discovered from the card or from any offline database, and
# it belongs beside the SIM source preference where it can be read, diffed and
# committed. This script still connects the bearer and netcfgd is still told
# only the result -- what moved is where the parameter is written down, not who
# dials.
#
# It arrives through `/run/netcfgd/modem/<interface>`, which netcfgd writes
# from that block (decision 0152) and this reads when `--apn` is not given.
# That is the interface report's shape pointed the other way: one file per
# device, `key=value`, no library and no socket. The same file carries `sim`,
# which is for the `pre_up` hook that drives a SIM mux rather than for this.

set -eu

usage() {
	sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'
	exit "${1:-2}"
}

command=${1:-}
[ -n "$command" ] || usage
shift || true

device=
interface=
apn=
user=
password=
interval=30

while [ $# -gt 0 ]; do
	case $1 in
		-d|--device)    device=${2:?--device needs a path}; shift 2 ;;
		-i|--interface) interface=${2:?--interface needs a name}; shift 2 ;;
		-a|--apn)       apn=${2:?--apn needs a name}; shift 2 ;;
		-u|--user)      user=${2:?--user needs a name}; shift 2 ;;
		-p|--password)  password=${2:?--password needs a value}; shift 2 ;;
		-n|--interval)  interval=${2:?--interval needs seconds}; shift 2 ;;
		-h|--help)      usage 0 ;;
		*) echo "netcfgd-modem-mbim: unknown option $1" >&2; exit 2 ;;
	esac
done

[ -n "$interface" ] || { echo "netcfgd-modem-mbim: --interface is required" >&2; exit 2; }

# The same directory netcfgd reads, and the same environment variable it
# honours, so a helper can be exercised somewhere other than /run.
run_dir=${NCFG_RUN_DIR:-/run/netcfgd}
report="$run_dir/reported/$interface"
selection="$run_dir/modem/$interface"

# What netcfgd published for this interface, if anything.
#
# The mirror of the interface report, and the other direction: netcfgd writes
# `sim` and `apn` from the document's `device <name> { modem { ... } }` block,
# this reads them. Decision 0152 -- and it is why decision 0150 could settle
# that the APN belongs in the document without the helper having to grow a
# parser or a socket. `key=value` lines, `#` comments, one file per device.
published() {
	[ -n "$interface" ] || return 0
	[ -f "$selection" ] || return 0
	sed -n "s/^$1=//p" "$selection" | head -n 1
}

# `--apn` still wins, so the script stays runnable by hand against a modem
# netcfgd knows nothing about. But a disagreement is said out loud rather than
# resolved in silence: an APN left behind in a unit file quietly overriding the
# document is exactly the confusion 0150 was settled to end.
from_document=$(published apn)
if [ -z "$apn" ]; then
	apn=$from_document
elif [ -n "$from_document" ] && [ "$from_document" != "$apn" ]; then
	echo "netcfgd-modem-mbim: --apn \`$apn\` overrides \`$from_document\`," >&2
	echo "netcfgd-modem-mbim:   which netcfgd published in $selection" >&2
fi

mbimcli=${MBIMCLI:-mbimcli}

# `--device-open-proxy` throughout. Without it each invocation opens and closes
# the control device, and closing it drops the session on a good many modems --
# so `connect` would succeed and `--query-ip-configuration` would come back
# empty. The proxy is started on demand by mbimcli itself.
mbim() {
	"$mbimcli" --device-open-proxy --device="$device" "$@"
}

# Atomically, as the contract asks: netcfgd may read at any moment and a
# half-written file is a file it will believe.
write_report() {
	mkdir -p "$run_dir/reported"
	cat > "$report.tmp"
	mv "$report.tmp" "$report"
}

# What `mbimcli --query-ip-configuration` prints, turned into what netcfgd
# reads. The format is out of libmbim 1.32's `mbimcli_print_ip_config`, which
# is the only place it is written down:
#
#     [/dev/cdc-wdm0] IPv4 configuration available: 'address, gateway, dns'
#          IP [0]: '10.64.1.23/30'
#         Gateway: '10.64.1.24'
#         DNS [0]: '8.8.8.8'
#             MTU: '1428'
#
# The v6 section repeats the same labels, so the family does not have to be
# tracked -- the addresses say which they are, and netcfgd takes both. Values
# are single-quoted, which is what makes this a `sed` rather than a parser.
#
# `mtu` is reported even though netcfgd ignores it today: the contract promises
# unknown keys are skipped, so reporting it costs nothing and the day netcfgd
# uses it this helper needs no change.
to_report() {
	sed -n "
		s/^ *IP \[[0-9]*\]: '\(.*\)'$/address=\1/p
		s/^ *Gateway: '\(.*\)'$/gateway=\1/p
		s/^ *DNS \[[0-9]*\]: '\(.*\)'$/dns=\1/p
		s/^ *MTU: '\(.*\)'$/mtu=\1/p
	"
}

# Connect the bearer and write what the network gave us.
connect_bearer() {
	[ -n "$device" ] || { echo "netcfgd-modem-mbim: --device is required" >&2; exit 2; }
	[ -n "$apn" ] || { echo "netcfgd-modem-mbim: --apn is required" >&2; exit 2; }

	# `access-string` is the APN. Credentials are passed only when given: an
	# empty `username=` is not the same as no username to every network.
	settings="access-string=$apn"
	[ -n "$user" ] && settings="$settings,username=$user"
	[ -n "$password" ] && settings="$settings,password=$password"

	if ! mbim --connect="$settings" > /dev/null; then
		echo "netcfgd-modem-mbim: could not connect $interface via $apn" >&2
		exit 1
	fi

	config=$(mbim --query-ip-configuration) || {
		echo "netcfgd-modem-mbim: connected but could not read the ip configuration" >&2
		exit 1
	}

	body=$(printf '%s\n' "$config" | to_report)
	if ! printf '%s\n' "$body" | grep -q '^address='; then
		# A bearer that connected and produced no address is not a bearer. Say
		# so rather than writing an empty report, which would tell netcfgd the
		# modem is down when it is up and misconfigured.
		echo "netcfgd-modem-mbim: $interface connected but the network gave no address" >&2
		exit 1
	fi

	printf '# %s via %s, %s\n%s\n' "$interface" "$apn" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
		"$body" | write_report
}

# Whether the bearer is still up, from `mbimcli --query-connection-state`:
#
#     [/dev/cdc-wdm0] Connection status:
#              Session ID: '0'
#        Activation state: 'activated'
#
# Tab-indented in libmbim's `g_print`, matched as whitespace here because a
# literal tab in a shell script is a thing somebody's editor eventually eats.
still_connected() {
	mbim --query-connection-state 2>/dev/null \
		| sed -n "s/^[[:space:]]*Activation state: '\(.*\)'\$/\1/p" \
		| grep -qx activated
}

case $command in
connect)
	connect_bearer
	;;

monitor)
	# The mode to run under a service manager. Cleaning up on the way out is
	# the whole reason it exists, so the trap is set before anything can fail.
	trap 'mbim --disconnect > /dev/null 2>&1 || true; rm -f "$report"; exit 0' INT TERM

	connect_bearer

	while :; do
		sleep "$interval"
		if still_connected; then
			continue
		fi
		# Emptied, not removed. This helper is still around and still watching,
		# and the contract says an empty report means "connected to nothing"
		# while a missing one means "nobody is watching this modem". netcfgd
		# withdraws the address and the default route either way; the
		# difference is what an operator reading /run sees.
		: | write_report
		echo "netcfgd-modem-mbim: the bearer on $interface went down" >&2
		# Non-zero so a service manager restarts this rather than treating a
		# dropped connection as a job well done. Reconnecting in a loop here
		# would be a supervisor written badly inside a script that does not
		# need to be one.
		exit 1
	done
	;;

disconnect)
	[ -n "$device" ] || { echo "netcfgd-modem-mbim: --device is required" >&2; exit 2; }
	mbim --disconnect > /dev/null || true
	# Truncated rather than removed: while this helper is around, an empty
	# report says "connected to nothing", which is different from "nobody is
	# watching this modem".
	: | write_report
	;;

stop)
	# The helper is going away, so the report stops being maintained and must
	# not be left for the next person to believe.
	rm -f "$report"
	;;

*)
	echo "netcfgd-modem-mbim: unknown command $command" >&2
	usage
	;;
esac
