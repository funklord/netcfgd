target/
**/*.rs.bk
*.swp

# fuzz corpora and artifacts: the targets are tracked, what they find is not
fuzz/target/
fuzz/corpus/
fuzz/artifacts/

# Local editor and tooling state. Nothing under these belongs in history.
.vscode/
.idea/

# The C client and the GUI build in place, the way the sibling projects do.
client/*.o
client/*.a
client/.build-flags
client/tests/client_test
gui/build/
gui/build-*/
gui/tests/build/
# The live GUI probe builds beside its own project file, which is in a
# subdirectory so that `make -C gui test` does not discover and run it without
# a daemon.
gui/tests/live/build/

# Built packages. The recipes and the metadata are tracked; the .deb and .apk
# they produce are not -- a package is a build artifact of a specific commit,
# and `make deb` reproduces it from that commit.
dist/

# debhelper's working state; debian/ holds packaging sources only.
debian/.debhelper/
debian/files
debian/tmp/
debian/netcfgd/
# The second binary package's staging tree. Named rather than globbed as
# `debian/netcfgd*/`, which would also swallow debian/netcfgd.postinst and any
# other per-package packaging source somebody adds later -- the rule above
# exists because debhelper's working state was committed once already.
debian/netcfgd-nm/
debian/netcfgd-gui/

# Python's own, beside whatever ran. `tools/` holds three gates now and
# importing one leaves this; it is not build output anybody named, which is
# why it is ignored rather than cleaned.
__pycache__/
debian/*.substvars
# The snippets dh_installsystemd and friends generate into maintainer scripts,
# as well as the log. `*.debhelper.log` alone missed `*.debhelper`, so
# `netcfgd.postrm.debhelper` sat in `git status` after every `make deb` -- and
# a line that is always there and never explained is what trains somebody to
# skim the list they are supposed to read before committing.
debian/*.debhelper
debian/*.debhelper.log
debian/debhelper-build-stamp

# fmake's object cache and the client it leaves at the top level.
# make writes its own build output under build/ instead.
.fmake/
/netcfgd-gui
