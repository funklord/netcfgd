# Contributor: @MAINTAINER@
# Maintainer: @MAINTAINER@
#
# netcfgd for Alpine. Generated from packaging/alpine/APKBUILD.in by `make apk`,
# which fills in the version and the maintainer rather than committing either.
#
# Nothing here is Alpine-specific except the init script and the dependency
# names: `make install` puts the two binaries and the configuration directory
# in place, and `make install-openrc` adds the one init file this machine runs.
# That split is decision-level -- installing a systemd unit on a machine
# without systemd is litter.
pkgname=netcfgd
pkgver=@PKGVER@
pkgrel=0
pkgdesc="Network configuration daemon that states what it will do"
url="https://github.com/netcfgd/netcfgd"
arch="all"
license="MIT OR Apache-2.0"
# **No ncurses, either to build against or at run time.** Both were here
# because the Rust `ncfg tui` binds it as a default-on cargo feature; the C
# writes its own escape sequences and `c/src/cli/tui_term.c` says why, so since
# 0266 nothing this package builds has linked it. `depends` is left empty
# rather than guessed at: the daemon needs the C library and nothing else, and
# Alpine's own tooling adds what a binary actually links.
depends=""
# **`linux-headers`, because Alpine does not ship them with its libc.** glibc
# distributions carry `linux/if_addr.h` and friends in libc6-dev, so this list
# never named them and `make apk-container` had not been run since the C port:
# it fails at the first `#include <linux/ethtool.h>` with or without the
# ncurses entry above, which is how that was measured rather than assumed.
makedepends="make linux-headers"
# No -doc and no -openrc subpackage: the init script is four lines of shell and
# splitting it out would mean a machine that installed netcfgd and got no way
# to run it. The default subpackages that would apply here are empty anyway.
subpackages=""
# The group `ncfg control set` points a policy at. Reserved and empty, the way
# the Debian package reserves it: every tier defaults to root, so a client run
# by an ordinary user is refused until somebody says otherwise, and joining a
# group is one of the two ways 0118 gives to say it.
#
# `pkggroups` rather than a post-install script, because abuild already knows
# how to create a group idempotently and a script that ran `addgroup` would be
# a second implementation of that.
pkggroups="netcfgd"

source="$pkgname-$pkgver.tar.gz"
builddir="$srcdir/$pkgname-$pkgver"
options="!check"

build() {
	# **Nothing to do here since 0266**, and that is the point rather than an
	# omission: the daemon is C with no dependency to lock, so `make install`
	# in `package()` builds it. This ran `cargo build --release --workspace
	# --locked` when the shipped binary was Rust; `--locked` mattered then
	# because a package built from a different dependency set is not the thing
	# that was tested.
	:
}

package() {
	make install DESTDIR="$pkgdir" PREFIX=/usr SYSCONFDIR=/etc
	make install-openrc DESTDIR="$pkgdir" SYSCONFDIR=/etc
}
