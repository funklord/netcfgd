#!/bin/sh /etc/rc.common
# netcfgd under procd, for OpenWrt.
#
# procd restarts and supervises; this script only describes. `respawn` is the
# whole supervision policy, which is why there is no restart logic here.

USE_PROCD=1

# After the network subsystem's own slot (20) so an interface renamed by
# board.d exists, and before anything that expects the network up.
START=21
STOP=89

start_service() {
	local home store

	mkdir -p /run/netcfgd
	# The fuzznet store, named rather than left to the default. procd starts a
	# service with HOME=/, so the default would be //.local/share/fuzznet --
	# a second node, where a fuzznetd run from root's shell never looks
	# (project.md 10.677). Root's home from the password database is where it
	# does look. Made here because netcfgd never makes a store it is told to
	# use: a mistyped one is refused rather than becoming a second node.
	home=$(awk -F: '$1 == "root" { print $6; exit }' /etc/passwd)
	store="${home:-/root}/.local/share/fuzznet"
	mkdir -p "$store" && chmod 700 "$store"
	procd_open_instance
	procd_set_param command /usr/sbin/netcfgd --fuzznet-dir "$store"
	# Reload rather than restart when the config changes: netcfgd recompiles
	# and reconciles, which is the whole point of it, and a reload does that
	# with no gap at all.
	#
	# This used to say restarting "would take the network down". Since 0134
	# that is not true -- a stop holds, and 0135 and 0136 let the daemon that
	# comes back recognise what the one before it installed. Reload is still
	# right and the reason is now that it is free rather than that the
	# alternative is destructive.
	procd_set_param file /etc/netcfgd/netcfgd.conf
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	/usr/bin/ncfg reload
}

service_triggers() {
	procd_add_reload_trigger "netcfgd"
}
