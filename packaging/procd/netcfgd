#!/bin/sh /etc/rc.common
# netcfgd under procd, for OpenWrt.
#
# procd restarts and supervises; this script only describes. `respawn` is the
# whole supervision policy, which is why there is no restart logic here.

USE_PROCD=1

# After the network subsystem's own slot (20) so an interface renamed by
# board.d exists, and before anything that expects the network up.
START=21
STOP=89

start_service() {
	mkdir -p /run/netcfgd
	procd_open_instance
	procd_set_param command /usr/sbin/netcfgd
	# Reload rather than restart when the config changes: netcfgd recompiles
	# and reconciles, which is the whole point of it, and restarting would
	# take the network down to do what it does without dropping a packet.
	procd_set_param file /etc/netcfgd/netcfgd.conf
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	/usr/bin/ncfg reload
}

service_triggers() {
	procd_add_reload_trigger "netcfgd"
}
