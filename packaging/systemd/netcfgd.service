# netcfgd under systemd.
#
# A text file and nothing more. Installing it creates no dependency on systemd,
# in the packaging sense or any other: a machine without systemd never reads
# it, and netcfgd links nothing from it. The same goes for the OpenRC and procd
# scripts beside it -- whichever init the machine runs picks up its own, and
# `make install` installs none of them unless asked.
#
# In particular there is no `Type=notify`, which would mean linking libsystemd.
# `Type=exec` gets most of what notify does -- systemd waits for the exec
# rather than the fork -- and costs nothing.

[Unit]
Description=netcfgd network configuration daemon

# Before the network is expected to work, and before anything that waits for
# it. `network-pre.target` is the passive one: firewalls and this hook into it
# so they are in place before interfaces come up.
Wants=network.target
Before=network.target
Wants=network-pre.target
Before=network-pre.target

# Not Conflicts=NetworkManager.service. That would stop NetworkManager
# entirely the moment netcfgd is enabled, including on machines where the
# operator wants it for devices netcfgd does not manage -- and netcfgd's own
# contention check is per-device for exactly that reason. The drop-in beside
# this file adds the conflict for anybody who does want it.

[Service]
Type=exec
ExecStart=/usr/sbin/netcfgd
ExecReload=/usr/bin/ncfg reload
Restart=on-failure
RestartSec=2

# netcfgd needs to configure interfaces and nothing else. CAP_NET_RAW is here
# for the children rather than for netcfgd: a wpa_supplicant driving a wired
# 802.1X port opens a packet socket, and it inherits the ambient set.
#
# CAP_CHOWN is for the control socket, and it was missing. The socket's group
# follows `global { control { ... } }` -- that is how a policy naming
# `group:netcfgd` becomes reachable by that group -- and giving a file to a
# group the process is not a member of needs CAP_CHOWN even as root. Without
# it the daemon set the mode to 0660, failed the chgrp, said so, and left a
# socket owned by root:root that no group member could open. Section 2.1 calls
# a policy the socket cannot honour "a lie that costs an afternoon to
# diagnose"; this unit was manufacturing exactly that, and only under systemd
# -- run from a shell as root the capability is present and everything works,
# which is why no test saw it.
#
# **The last three are dhcpcd's, not netcfgd's.** dhcpcd is built with PRIVSEP
# and has no flag to turn it off -- `strings` shows the feature compiled in and
# the option table carries nothing for it -- so on start it chroots into
# /usr/lib/dhcpcd and drops to an unprivileged user. Without CAP_SYS_CHROOT and
# the two setuid capabilities the bounding set forbids both, and dhcpcd reports:
#
#     ps_dropprivs: chroot: /usr/lib/dhcpcd: Operation not permitted
#     failed to drop privileges: Operation not permitted
#     script_runreason: Permission denied
#
# It then carries on without privsep and cannot run the hook that installs the
# lease, so the interface waits for carrier forever and no address arrives.
# Measured on a real machine; the daemon said all three lines and netcfgd
# reported success.
#
# **This widens the ceiling for the daemons netcfgd spawns, not for netcfgd.**
# netcfgd calls none of these -- it is already root and never chroots or
# changes user. What a bounding set does is cap what a child may hold, and
# capping it below what dhcpcd needs is how a sandbox stops a daemon doing the
# one thing it was started for. Ambient stays as it was: these are available to
# be dropped into, not handed out.
#
# **`CAP_NET_BIND_SERVICE`, and it is ambient rather than only bounded.** A DHCP
# client binds UDP port 68, which is privileged, and dhcpcd does it from the
# privilege-separated child that owns the socket -- so a bounding-set entry
# nobody holds is no use here. Without it, measured on the reporting machine:
#
#     dhcpcd: ps_inet_listenin: Permission denied
#     dhcpcd: BOOTP proxy 10.0.125.56 exited unexpectedly from PID ..., code=1
#     dhcpcd: ps_root_recvmsg: Permission denied
#
# **The lease still arrives**, over the raw socket `CAP_NET_RAW` allows, so the
# address and the routes appear and netcfgd reports success. What dies is the
# proxy that carries the lease's *options* -- so the hook is invoked, writes its
# report, and the report holds a header and not one `dns=` line. The machine
# came up addressed, routed and unable to resolve anything, with nothing in
# netcfgd's log saying so.
#
# Confirmed directly rather than inferred: binding UDP 68 under the set above
# answers `EACCES`, and answers `OK` with this line added.
#
# This is the second half of a pair. The hook could not be *executed* because
# `/run` is `noexec` (0178); once it could, it had nothing to report because
# the client could not bind. Either alone produces the same empty resolver, and
# fixing one leaves the symptom exactly where it was -- which is how the first
# fix looked like no fix at all.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_CHOWN CAP_SYS_CHROOT CAP_SETUID CAP_SETGID CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_CHOWN CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

# `yes`: /usr and the boot directories read-only, /etc left alone.
#
# **Not `full`, and this is the third time this one word has broken the
# daemon.** The comment that used to sit here got it right and then acted on
# it backwards. It correctly quoted systemd.exec(5) -- "If set to 'full', the
# /etc/ directory is mounted read-only, too" -- and then kept `full` and tried
# to reopen /etc with `ReadWritePaths=/etc` below. **That grant is inert.**
# `ProtectSystem=` applies its read-only remount *after* the ReadWritePaths
# bind mounts, so naming the very path `full` protects grants nothing at all.
#
# Measured on debian-nabbe, systemd 257, with `systemd-run -p ...` and a
# control for each row:
#
#     ProtectSystem=full   ReadWritePaths=/etc            -> /etc ro,  EROFS
#     ProtectSystem=full   ReadWritePaths=/etc/netcfgd    -> /etc ro,  subpath rw
#     ProtectSystem=yes    ReadWritePaths=/etc            -> /etc rw
#     ProtectSystem=strict ReadWritePaths=/etc            -> /etc rw
#
# A *subpath* grant survives, which is why 0131's four narrow paths worked and
# 0164's single wide one does not: consolidating them silently reverted 0131.
# Under the shipped line nothing under /etc was writable at all -- not
# `/etc/netcfgd`, so every client write 0127 built was refused, and not the
# `/etc` directory, so `write_resolv_conf` could not stage. The daemon said so
# on every start; the remedy it printed was to name the path in
# `ReadWritePaths=`, and the path was already named.
#
# **Not `strict`**, which was the other candidate and is wrong for a reason
# worth keeping: it takes the whole hierarchy, so `/run` and `/var/lib` go
# read-only too. Measured, that leaves the supplicant no `/run/wpa_supplicant`
# for its control socket and dhcpcd no `/var/lib/dhcpcd` -- netcfgd's children
# inherit this mount namespace, so a grant it does not make is one they do not
# get either.
#
# 0164 rejected this spelling as "same practical exposure, expressed as a
# lower hardening level rather than a named path, so a reader cannot see why
# it was lowered". The exposure is the same; the *access* is not, which is
# what that rejection assumed and no one had measured. The `ReadWritePaths=`
# line below therefore stays: under `yes` it grants nothing new, and it is
# what says which directory the lowering was for.
ProtectSystem=yes

# Which directory the hardening above was lowered for. Under `ProtectSystem=yes`
# this grants nothing that /etc did not already have -- it is documentation
# with teeth, and it is what a reader checks against the line above.
#
# **/etc/netcfgd is load-bearing since 0127**, which made netcfgd the *only*
# writer of its own configuration -- a client cannot write there, so it sends
# what it has over the socket and netcfgd writes it. The unit used to carry
# `ReadOnlyPaths=/etc/netcfgd` with the comment "netcfgd never writes to it,
# so the init system enforces what the code already promises". That promise was
# reversed by 0127 and the unit was not. The result is that `wifi_add`,
# `config_put`, `secret_put`, `config_delete`, `secret_delete` and `radio_set`
# were all refused by netcfgd's own sandbox -- the entire collapse 0127 built,
# unreachable on every packaged install. Reported from a desktop: the GUI
# relayed "read-only file system" naming a path the *daemon* had tried to
# write, which reads as though the client had gone behind the socket's back.
#
# The DNS paths are the ones the comment above was always about. `-` on the
# three optional ones: dnsmasq and unbound are packages a machine need not
# have, and a unit that refuses to start for want of a directory belonging to
# software nobody installed would be worse than the fault it prevents.
# **A path named here grants the file, not the directory it sits in**, and
# that is why this is now one line rather than four (0164).
#
# 0161 granted `-/etc/resolv.conf` and had netcfgd write that one file in
# place, giving up the atomic replace rather than widening the grant. It fixed
# the machine it was reproduced on and not the common one. `/etc/resolv.conf`
# is a **symlink** into another resolver's runtime state on any machine running
# systemd-resolved -- and netcfgd must not write through such a link, because
# that edits systemd-resolved's own file. So the in-place path refuses, the
# staging path is refused by the sandbox, and `write_resolv_conf` could not
# work at all there. Reported from a systemd machine and reproduced with these
# exact mounts: the apply stopped at action 0 and resolv.conf was untouched.
#
# Replacing a symlink means unlinking it and creating a file, which needs the
# **directory**. There is no narrower systemd grant that allows creating one
# named entry: `rename(2)` needs write on the destination directory, and
# staging under /run cannot be renamed across a filesystem boundary (EXDEV).
# So the choice was to grant /etc or to leave the mode broken on the machines
# most people run, and the copyright holder chose the grant.
#
# What it costs, stated plainly: netcfgd may write any file under /etc, not
# just the four this used to name. `ProtectSystem=yes` still holds /usr,
# /boot and /efi read-only. `/etc/netcfgd`, `/etc/resolv.conf`,
# `/etc/dnsmasq.d` and `/etc/unbound/unbound.conf.d` are all subsumed by this
# line, so they are gone rather than kept as documentation -- four redundant
# entries would read as a narrower grant than the one in force.
#
# `tests/live/sandbox_writes.sh` drives both the symlink and the regular-file
# case under real mounts, and fails if this line ever narrows again.
ReadWritePaths=/etc

RuntimeDirectory=netcfgd
RuntimeDirectoryMode=0755
# Keep /run/netcfgd across a restart, so that an upgrade does not throw away
# the record of what netcfgd installed. The default is `no`, which deletes it
# whenever the service stops -- systemd.exec(5): the directories "are always
# removed when the service stops".
#
# This is not what makes a restart safe. Addresses and routes carry netcfgd's
# protocol tag in the kernel and are recognised again with no record at all
# (0002, and `tests/live/adopt.sh` runs the cycle with the file deleted). What
# the record still carries is everything the kernel has nowhere to stamp: which
# sysctls netcfgd changed, which links it created, which DNS scopes it
# delivered. Losing those means netcfgd stops putting them back, which holds
# rather than breaks -- but it is avoidable across a restart, so avoid it.
#
# `restart` and not `yes`: a real stop should still clean up. An operator who
# stops the service deliberately is not mid-upgrade, and leaving the directory
# behind for ever would make the reboot case look like a restart.
RuntimeDirectoryPreserve=restart

# **What is NOT in that directory, and must never be put there (0163).**
#
# The commit-confirm window and the document it reverts to live in
# /run/netcfgd-confirm, which systemd does not manage. The line above is why:
# it deletes /run/netcfgd on a real stop, so a window kept there survived
# `systemctl restart` and was destroyed by `systemctl stop` followed by
# `systemctl start` -- two spellings of one intent, and the careful-looking
# one silently kept a change nobody had confirmed. It also made the answer
# differ by init, since OpenRC, procd and sysvinit never remove that
# directory at all.
#
# Everything else netcfgd records is a claim about an object that still
# exists, so it can be rebuilt by asking the object -- a kernel protocol tag,
# a link mark, a marker in a backend's own argv. A window cannot be: it
# asserts that somebody did NOT come back, and nothing in the world holds a
# copy of that.
#
# So do not add `RuntimeDirectory=netcfgd-confirm` here. It is the natural
# thing to add on noticing a second directory, and it reintroduces the fault
# exactly. `tests/live/killmode.sh` fails if this file ever names it.

# **Declared rather than defaulted, and the value is deliberate (0142).**
#
# systemd's default is `control-group`, which kills every process in the unit's
# cgroup on stop -- including the wpa_supplicant and dhcpcd netcfgd started.
# Decision 0134 says an unannounced stop *holds*, and reasoned from netcfgd's
# own source: no SIGTERM teardown in the daemon, no ExecStop in this file. That
# skipped the init, which does the killing regardless. So 0134 was true of
# netcfgd and false of the system, and its tests could not have caught it --
# they run netcfgd as a plain child in a namespace, where no cgroup reaping
# exists.
#
# **`process` now, which is what 0134 always wanted** -- and the order that got
# here matters. This said `control-group` until every backend could be
# re-adopted, because holding what cannot be recovered is worse than not
# holding it: an orphan netcfgd can neither identify nor stop was measured on a
# real machine at one DHCP lease a minute for two hours.
#
# All of them can now. The supplicant, openvpn, radvd, hostapd and udhcpc are
# found by a path netcfgd composed sitting in their own `argv` (0140); dhcpcd
# destroys its argv and its environment with `setproctitle`, so it is asked
# over its control socket which config file it was started with (0143).
#
# What this buys: `systemctl stop netcfgd`, and therefore every package
# upgrade, stops taking the network down. That is the whole of 0134, and it was
# false for as long as this line was absent.
#
# `process` rather than `mixed`: mixed SIGTERMs the main process and then
# SIGKILLs the rest of the cgroup, which is control-group's behaviour wearing a
# gentler name. `none` is refused by `tests/live/killmode.sh` -- systemd's own
# manual calls it not recommended, and netcfgd has no teardown of its own to
# make up for it.
KillMode=process

[Install]
WantedBy=multi-user.target
