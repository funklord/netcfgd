# netcfgd under systemd.
#
# A text file and nothing more. Installing it creates no dependency on systemd,
# in the packaging sense or any other: a machine without systemd never reads
# it, and netcfgd links nothing from it. The same goes for the OpenRC and procd
# scripts beside it -- whichever init the machine runs picks up its own, and
# `make install` installs none of them unless asked.
#
# In particular there is no `Type=notify`, which would mean linking libsystemd.
# `Type=exec` gets most of what notify does -- systemd waits for the exec
# rather than the fork -- and costs nothing.

[Unit]
Description=netcfgd network configuration daemon

# Before the network is expected to work, and before anything that waits for
# it. `network-pre.target` is the passive one: firewalls and this hook into it
# so they are in place before interfaces come up.
Wants=network.target
Before=network.target
Wants=network-pre.target
Before=network-pre.target

# Not Conflicts=NetworkManager.service. That would stop NetworkManager
# entirely the moment netcfgd is enabled, including on machines where the
# operator wants it for devices netcfgd does not manage -- and netcfgd's own
# contention check is per-device for exactly that reason. The drop-in beside
# this file adds the conflict for anybody who does want it.

[Service]
Type=exec
ExecStart=/usr/sbin/netcfgd
ExecReload=/usr/bin/ncfg reload
Restart=on-failure
RestartSec=2

# netcfgd needs to configure interfaces and nothing else. CAP_NET_RAW is here
# for the children rather than for netcfgd: a wpa_supplicant driving a wired
# 802.1X port opens a packet socket, and it inherits the ambient set.
#
# CAP_CHOWN is for the control socket, and it was missing. The socket's group
# follows `global { control { ... } }` -- that is how a policy naming
# `group:netcfgd` becomes reachable by that group -- and giving a file to a
# group the process is not a member of needs CAP_CHOWN even as root. Without
# it the daemon set the mode to 0660, failed the chgrp, said so, and left a
# socket owned by root:root that no group member could open. Section 2.1 calls
# a policy the socket cannot honour "a lie that costs an afternoon to
# diagnose"; this unit was manufacturing exactly that, and only under systemd
# -- run from a shell as root the capability is present and everything works,
# which is why no test saw it.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_CHOWN
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_CHOWN
NoNewPrivileges=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

# `full`: /usr, the boot directories **and /etc** read-only. Not `strict`,
# which would take the whole hierarchy including /run and /var and leave
# netcfgd unable to write its own runtime state.
#
# The comment that used to sit here had this backwards. It said "strict would
# make /etc read-only, and the DNS backends legitimately write there", and
# chose `full` to avoid that -- but `full` is precisely what mounts /etc
# read-only (systemd.exec(5): "If set to 'full', the /etc/ directory is
# mounted read-only, too"). So the setting delivered the exact hazard the
# comment named it to avoid, and every write netcfgd makes under /etc had been
# failing with EROFS on any systemd machine.
ProtectSystem=full

# What netcfgd genuinely writes under /etc, named one by one. This is the half
# `ProtectSystem=full` leaves to the unit: harden everything, then say what
# must stay writable.
#
# **/etc/netcfgd is load-bearing since 0127**, which made netcfgd the *only*
# writer of its own configuration -- a client cannot write there, so it sends
# what it has over the socket and netcfgd writes it. The unit used to carry
# `ReadOnlyPaths=/etc/netcfgd` with the comment "netcfgd never writes to it,
# so the init system enforces what the code already promises". That promise was
# reversed by 0127 and the unit was not. The result is that `wifi_add`,
# `config_put`, `secret_put`, `config_delete`, `secret_delete` and `radio_set`
# were all refused by netcfgd's own sandbox -- the entire collapse 0127 built,
# unreachable on every packaged install. Reported from a desktop: the GUI
# relayed "read-only file system" naming a path the *daemon* had tried to
# write, which reads as though the client had gone behind the socket's back.
#
# The DNS paths are the ones the comment above was always about. `-` on the
# three optional ones: dnsmasq and unbound are packages a machine need not
# have, and a unit that refuses to start for want of a directory belonging to
# software nobody installed would be worse than the fault it prevents.
ReadWritePaths=/etc/netcfgd
ReadWritePaths=-/etc/resolv.conf
ReadWritePaths=-/etc/dnsmasq.d
ReadWritePaths=-/etc/unbound/unbound.conf.d

RuntimeDirectory=netcfgd
RuntimeDirectoryMode=0755
# Keep /run/netcfgd across a restart, so that an upgrade does not throw away
# the record of what netcfgd installed. The default is `no`, which deletes it
# whenever the service stops -- systemd.exec(5): the directories "are always
# removed when the service stops".
#
# This is not what makes a restart safe. Addresses and routes carry netcfgd's
# protocol tag in the kernel and are recognised again with no record at all
# (0002, and `tests/live/adopt.sh` runs the cycle with the file deleted). What
# the record still carries is everything the kernel has nowhere to stamp: which
# sysctls netcfgd changed, which links it created, which DNS scopes it
# delivered. Losing those means netcfgd stops putting them back, which holds
# rather than breaks -- but it is avoidable across a restart, so avoid it.
#
# `restart` and not `yes`: a real stop should still clean up. An operator who
# stops the service deliberately is not mid-upgrade, and leaving the directory
# behind for ever would make the reboot case look like a restart.
RuntimeDirectoryPreserve=restart

# **Declared rather than defaulted, and the value is deliberate (0142).**
#
# systemd's default is `control-group`, which kills every process in the unit's
# cgroup on stop -- including the wpa_supplicant and dhcpcd netcfgd started.
# Decision 0134 says an unannounced stop *holds*, and reasoned from netcfgd's
# own source: no SIGTERM teardown in the daemon, no ExecStop in this file. That
# skipped the init, which does the killing regardless. So 0134 was true of
# netcfgd and false of the system, and its tests could not have caught it --
# they run netcfgd as a plain child in a namespace, where no cgroup reaping
# exists.
#
# `process` is what 0134 actually wants, and it is NOT set yet. It would leave
# every backend running after a stop, and netcfgd cannot yet re-adopt all of
# them: it recovers its supplicant from the `-P` path in argv (0140), but
# dhcpcd calls setproctitle and destroys both its argv and its environment, so
# a held dhcpcd is one nothing can identify or stop. Measured on a real
# machine: an orphan renewing once a minute for two hours, thirteen addresses
# consumed.
#
# **So the order is: adoption first, then this flips.** Holding what cannot be
# re-adopted is worse than not holding it, and `control-group` is the honest
# state until every backend can be recovered.
KillMode=control-group

[Install]
WantedBy=multi-user.target
